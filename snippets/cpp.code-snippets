    "SegmentTree": {
        "prefix": "!SegmentTree",
        "body": [
            "",
            "template<class S, S (*op)(S, S), S (*e)()>",
            "struct SegmentTree {",
            "private:",
            "    int n;",
            "    int size;",
            "    vector<S> data;",
            "",
            "    // 親ノードの値を更新",
            "    void update(int k) {",
            "        data[k] = op(data[2 * k], data[2 * k + 1]);",
            "    }",
            "",
            "public:",
            "    // 初期化: SegmentTree(要素数) -> 全要素を e() に設定",
            "    // 前提: 要素数 >= 0、op は結合則を満たし、e() は op の単位元",
            "    SegmentTree(int element_count) : n(element_count), size(1) {",
            "        assert(element_count >= 0);",
            "",
            "        while (size < n) size *= 2;",
            "        data.assign(2 * size, e());",
            "    }",
            "",
            "    // 初期化: SegmentTree(初期配列) -> 配列の値を使って構築",
            "    // 使用例 (区間和): op(a,b)=a+b、e()=0 と定義し、SegmentTree<long long, op, e> seg(v); seg.prod(0, v.size());",
            "    SegmentTree(const vector<S>& v) : SegmentTree((int)v.size()) {",
            "        // 葉に初期値を配置し、下から親を構築",
            "        for (int i = 0; i < n; i++) {",
            "            data[size + i] = v[i];",
            "        }",
            "        for (int i = size - 1; i >= 1; i--) {",
            "            update(i);",
            "        }",
            "    }",
            "",
            "    // 点更新: set(位置 p, 値 x) -> a[p] を x に変更",
            "    void set(int p, S x) {",
            "        assert(0 <= p && p < n);",
            "",
            "        p += size;",
            "        data[p] = x;",
            "        while (p > 1) {",
            "            p /= 2;",
            "            update(p);",
            "        }",
            "    }",
            "",
            "    // 点取得: get(位置 p) -> a[p]",
            "    S get(int p) const {",
            "        assert(0 <= p && p < n);",
            "        return data[size + p];",
            "    }",
            "",
            "    // 区間取得: prod(左端 l, 右端 r) -> [l, r) の演算結果",
            "    S prod(int l, int r) const {",
            "        assert(0 <= l && l <= r && r <= n);",
            "",
            "        S left_value = e();",
            "        S right_value = e();",
            "        l += size;",
            "        r += size;",
            "",
            "        // 左右の結果を分け、非可換演算でも順序を保つ",
            "        while (l < r) {",
            "            if (l & 1) left_value = op(left_value, data[l++]);",
            "            if (r & 1) right_value = op(data[--r], right_value);",
            "            l /= 2;",
            "            r /= 2;",
            "        }",
            "        return op(left_value, right_value);",
            "    }",
            "",
            "    // 全区間取得: all_prod() -> [0, n) の演算結果",
            "    S all_prod() const {",
            "        return data[1];",
            "    }",
            "",
            "    // 右方向の二分探索: max_right(左端 l, 判定関数 f) -> f(prod(l, r)) が true となる最大の r",
            "    // 前提: f(e()) == true、f は区間を右へ伸ばすと true から false にのみ変化する",
            "    template<class F>",
            "    int max_right(int l, F f) const {",
            "        assert(0 <= l && l <= n);",
            "        assert(f(e()));",
            "        if (l == n) return n;",
            "",
            "        l += size;",
            "        S value = e();",
            "        do {",
            "            while ((l & 1) == 0) l /= 2;",
            "            if (!f(op(value, data[l]))) {",
            "                // 条件が初めて破れる葉まで降りる",
            "                while (l < size) {",
            "                    l *= 2;",
            "                    if (f(op(value, data[l]))) {",
            "                        value = op(value, data[l]);",
            "                        l++;",
            "                    }",
            "                }",
            "                return l - size;",
            "            }",
            "            value = op(value, data[l]);",
            "            l++;",
            "        } while ((l & -l) != l);",
            "        return n;",
            "    }",
            "",
            "    // 左方向の二分探索: min_left(右端 r, 判定関数 f) -> f(prod(l, r)) が true となる最小の l",
            "    // 前提: f(e()) == true、f は区間を左へ伸ばすと true から false にのみ変化する",
            "    template<class F>",
            "    int min_left(int r, F f) const {",
            "        assert(0 <= r && r <= n);",
            "        assert(f(e()));",
            "        if (r == 0) return 0;",
            "",
            "        r += size;",
            "        S value = e();",
            "        do {",
            "            r--;",
            "            while (r > 1 && (r & 1)) r /= 2;",
            "            if (!f(op(data[r], value))) {",
            "                // 条件が初めて破れる葉まで降りる",
            "                while (r < size) {",
            "                    r = 2 * r + 1;",
            "                    if (f(op(data[r], value))) {",
            "                        value = op(data[r], value);",
            "                        r--;",
            "                    }",
            "                }",
            "                return r + 1 - size;",
            "            }",
            "            value = op(data[r], value);",
            "        } while ((r & -r) != r);",
            "        return 0;",
            "    }",
            "};",
            ""
        ]
    },
    "ModInt": {
        "prefix": "!ModInt",
        "body": [
            "",
            "template<int MOD>",
            "struct ModInt {",
            "    static_assert(MOD >= 2, \"MOD must be at least 2\");",
            "",
            "private:",
            "    int value;",
            "",
            "public:",
            "    // 初期化: ModInt() -> 0",
            "    ModInt() : value(0) {}",
            "",
            "    // 初期化: ModInt(x) -> 整数 x を [0, MOD) に正規化",
            "    template<class T, enable_if_t<is_integral_v<T>, int> = 0>",
            "    ModInt(T x) {",
            "        auto y = x % MOD;",
            "        if constexpr (is_signed_v<T>) {",
            "            if (y < 0) y += MOD;",
            "        }",
            "        value = (int)y;",
            "    }",
            "",
            "    // 値取得: val() -> [0, MOD) の整数",
            "    int val() const {",
            "        return value;",
            "    }",
            "",
            "    // 法の取得: mod() -> MOD",
            "    static constexpr int mod() {",
            "        return MOD;",
            "    }",
            "",
            "    // 正規化済みの値から生成: raw(x) -> x (前提: 0 <= x < MOD)",
            "    static ModInt raw(int x) {",
            "        assert(0 <= x && x < MOD);",
            "        ModInt result;",
            "        result.value = x;",
            "        return result;",
            "    }",
            "",
            "    // 加算代入: a += b -> (a + b) mod MOD",
            "    ModInt& operator+=(const ModInt& other) {",
            "        unsigned int x = (unsigned int)value + (unsigned int)other.value;",
            "        if (x >= (unsigned int)MOD) x -= MOD;",
            "        value = (int)x;",
            "        return *this;",
            "    }",
            "",
            "    // 減算代入: a -= b -> (a - b) mod MOD",
            "    ModInt& operator-=(const ModInt& other) {",
            "        value -= other.value;",
            "        if (value < 0) value += MOD;",
            "        return *this;",
            "    }",
            "",
            "    // 乗算代入: a *= b -> (a * b) mod MOD",
            "    ModInt& operator*=(const ModInt& other) {",
            "        value = (int)((long long)value * other.value % MOD);",
            "        return *this;",
            "    }",
            "",
            "    // 除算代入: a /= b -> a * b.inv() (前提: gcd(b, MOD) == 1)",
            "    ModInt& operator/=(const ModInt& other) {",
            "        return *this *= other.inv();",
            "    }",
            "",
            "    // 累乗: pow(n) -> a^n mod MOD (前提: n >= 0)",
            "    ModInt pow(long long n) const {",
            "        assert(n >= 0);",
            "        ModInt result = 1;",
            "        ModInt base = *this;",
            "        while (n > 0) {",
            "            if (n & 1) result *= base;",
            "            base *= base;",
            "            n >>= 1;",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 逆元: inv() -> a^(-1) mod MOD (前提: gcd(a, MOD) == 1)",
            "    ModInt inv() const {",
            "        long long a = value;",
            "        long long b = MOD;",
            "        long long x = 1;",
            "        long long y = 0;",
            "",
            "        // 拡張Euclid互除法で a * x + MOD * y = gcd(a, MOD) を求める",
            "        while (b != 0) {",
            "            long long q = a / b;",
            "            a -= q * b;",
            "            swap(a, b);",
            "            x -= q * y;",
            "            swap(x, y);",
            "        }",
            "        assert(a == 1);",
            "        return ModInt(x);",
            "    }",
            "",
            "    // 単項演算: +a, -a -> 正符号、加法逆元",
            "    ModInt operator+() const { return *this; }",
            "    ModInt operator-() const { return value == 0 ? *this : raw(MOD - value); }",
            "",
            "    // 前置・後置インクリメント: ++a, a++ -> 1 加算",
            "    ModInt& operator++() {",
            "        value++;",
            "        if (value == MOD) value = 0;",
            "        return *this;",
            "    }",
            "    ModInt operator++(int) {",
            "        ModInt result = *this;",
            "        ++*this;",
            "        return result;",
            "    }",
            "",
            "    // 前置・後置デクリメント: --a, a-- -> 1 減算",
            "    ModInt& operator--() {",
            "        if (value == 0) value = MOD;",
            "        value--;",
            "        return *this;",
            "    }",
            "    ModInt operator--(int) {",
            "        ModInt result = *this;",
            "        --*this;",
            "        return result;",
            "    }",
            "",
            "    // 四則演算: a + b, a - b, a * b, a / b -> 演算結果",
            "    friend ModInt operator+(ModInt left, const ModInt& right) { return left += right; }",
            "    friend ModInt operator-(ModInt left, const ModInt& right) { return left -= right; }",
            "    friend ModInt operator*(ModInt left, const ModInt& right) { return left *= right; }",
            "    friend ModInt operator/(ModInt left, const ModInt& right) { return left /= right; }",
            "",
            "    // 比較: a == b, a != b -> 保持値の等値判定",
            "    friend bool operator==(const ModInt& left, const ModInt& right) { return left.value == right.value; }",
            "    friend bool operator!=(const ModInt& left, const ModInt& right) { return left.value != right.value; }",
            "",
            "    // 出力: os << a -> 保持値を整数で出力",
            "    friend ostream& operator<<(ostream& os, const ModInt& a) {",
            "        return os << a.value;",
            "    }",
            "",
            "    // 入力: is >> a -> long long の整数を読み込み正規化",
            "    friend istream& operator>>(istream& is, ModInt& a) {",
            "        long long x;",
            "        if (is >> x) a = ModInt(x);",
            "        return is;",
            "    }",
            "};",
            ""
        ]
    },
    "RunLengthEncoding": {
        "prefix": "!RunLengthEncoding",
        "body": [
            "",
            "// 配列をランレングス圧縮: 連続する等しい要素を {値, 個数} に変換",
            "// 引数: v は元の配列 (前提: v.size() <= INT_MAX、T は等値比較・コピー可能)",
            "// 戻り値: 圧縮結果を元の順序で並べた vector<pair<T, int>>",
            "template<class T>",
            "vector<pair<T, int>> run_length_encode(const vector<T>& v) {",
            "    assert(v.size() <= (size_t)INT_MAX);",
            "",
            "    vector<pair<T, int>> result;",
            "    for (const T& x : v) {",
            "        if (result.empty() || !(result.back().first == x)) {",
            "            result.emplace_back(x, 1);",
            "        } else {",
            "            result.back().second++;",
            "        }",
            "    }",
            "    return result;",
            "}",
            "",
            "// 文字列をランレングス圧縮: 連続する同じバイトを {文字, 個数} に変換",
            "// 引数: s は元の文字列 (前提: s.size() <= INT_MAX)",
            "// 戻り値: vector<pair<char, int>>。文字はバイト単位で扱う",
            "vector<pair<char, int>> run_length_encode(const string& s) {",
            "    assert(s.size() <= (size_t)INT_MAX);",
            "",
            "    vector<pair<char, int>> result;",
            "    for (char c : s) {",
            "        if (result.empty() || result.back().first != c) {",
            "            result.emplace_back(c, 1);",
            "        } else {",
            "            result.back().second++;",
            "        }",
            "    }",
            "    return result;",
            "}",
            "",
            "// 配列の復元: 各 {値, 個数} を個数分だけ並べる",
            "// 引数: rle は圧縮結果 (前提: すべての個数が正、合計要素数が格納可能)",
            "// 戻り値: 復元された vector<T>",
            "template<class T>",
            "vector<T> run_length_decode(const vector<pair<T, int>>& rle) {",
            "    vector<T> result;",
            "    size_t total = 0;",
            "    for (const auto& [x, count] : rle) {",
            "        assert(count > 0);",
            "        assert((size_t)count <= result.max_size() - total);",
            "        total += (size_t)count;",
            "    }",
            "",
            "    result.reserve(total);",
            "    for (const auto& [x, count] : rle) {",
            "        result.insert(result.end(), count, x);",
            "    }",
            "    return result;",
            "}",
            "",
            "// 文字列の復元: 各 {文字, 個数} を個数分だけ連結",
            "// 引数: rle は圧縮結果 (前提: すべての個数が正、合計文字数が格納可能)",
            "// 戻り値: 復元された string",
            "string run_length_decode_string(const vector<pair<char, int>>& rle) {",
            "    string result;",
            "    size_t total = 0;",
            "    for (const auto& [c, count] : rle) {",
            "        assert(count > 0);",
            "        assert((size_t)count <= result.max_size() - total);",
            "        total += (size_t)count;",
            "    }",
            "",
            "    result.reserve(total);",
            "    for (const auto& [c, count] : rle) {",
            "        result.append(count, c);",
            "    }",
            "    return result;",
            "}",
            ""
        ]
    },
    "UnionFind": {
        "prefix": "!UnionFind",
        "body": [
            "",
            "struct UnionFind {",
            "private:",
            "    int n;",
            "    int component_count;",
            "    vector<int> parent_or_size;",
            "    vector<int> next;",
            "",
            "public:",
            "    // 初期化: UnionFind() -> 要素数0の集合を生成",
            "    UnionFind() : UnionFind(0) {}",
            "",
            "    // 初期化: UnionFind(要素数 n) -> n 個の独立した集合を生成 (前提: n >= 0)",
            "    UnionFind(int element_count) : n(element_count), component_count(element_count) {",
            "        assert(element_count >= 0);",
            "        parent_or_size.assign(n, -1);",
            "        next.resize(n);",
            "        iota(next.begin(), next.end(), 0);",
            "    }",
            "",
            "    // 集合の統合: merge(a, b) -> 統合後の代表元 (前提: 0 <= a, b < n)",
            "    int merge(int a, int b) {",
            "        assert(0 <= a && a < n && 0 <= b && b < n);",
            "        a = leader(a);",
            "        b = leader(b);",
            "        if (a == b) return a;",
            "",
            "        // 小さい集合を大きい集合に統合する",
            "        if (-parent_or_size[a] < -parent_or_size[b]) swap(a, b);",
            "        parent_or_size[a] += parent_or_size[b];",
            "        parent_or_size[b] = a;",
            "",
            "        // 各集合の循環リストを連結する",
            "        swap(next[a], next[b]);",
            "        component_count--;",
            "        return a;",
            "    }",
            "",
            "    // 同一集合判定: same(a, b) -> 同じ集合なら true (前提: 0 <= a, b < n)",
            "    bool same(int a, int b) {",
            "        assert(0 <= a && a < n && 0 <= b && b < n);",
            "        return leader(a) == leader(b);",
            "    }",
            "",
            "    // 代表元取得: leader(a) -> a の所属する集合の代表元 (前提: 0 <= a < n)",
            "    int leader(int a) {",
            "        assert(0 <= a && a < n);",
            "        if (parent_or_size[a] < 0) return a;",
            "        return parent_or_size[a] = leader(parent_or_size[a]);",
            "    }",
            "",
            "    // 集合サイズ取得: size(a) -> a の所属する集合の要素数 (前提: 0 <= a < n)",
            "    int size(int a) {",
            "        assert(0 <= a && a < n);",
            "        return -parent_or_size[leader(a)];",
            "    }",
            "",
            "    // 集合数取得: count() -> 現在の集合数",
            "    int count() const {",
            "        return component_count;",
            "    }",
            "",
            "    // 所属集合取得: group(a) -> a の所属する集合の要素一覧 (前提: 0 <= a < n、順序は不定)",
            "    vector<int> group(int a) {",
            "        int root = leader(a);",
            "        vector<int> result;",
            "        result.reserve(-parent_or_size[root]);",
            "        int v = root;",
            "        do {",
            "            result.push_back(v);",
            "            v = next[v];",
            "        } while (v != root);",
            "        return result;",
            "    }",
            "",
            "    // 全集合取得: groups() -> 各集合の要素一覧 (集合・要素の順序は不定)",
            "    vector<vector<int>> groups() {",
            "        vector<vector<int>> result;",
            "        result.reserve(component_count);",
            "        for (int root = 0; root < n; root++) {",
            "            if (parent_or_size[root] >= 0) continue;",
            "            vector<int> group;",
            "            group.reserve(-parent_or_size[root]);",
            "            int v = root;",
            "            do {",
            "                group.push_back(v);",
            "                v = next[v];",
            "            } while (v != root);",
            "            result.push_back(move(group));",
            "        }",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "Prime": {
        "prefix": "!Prime",
        "body": [
            "",
            "struct Prime {",
            "private:",
            "    using u64 = unsigned long long;",
            "    using u128 = __uint128_t;",
            "",
            "    int limit;",
            "    vector<int> spf;",
            "    vector<int> prime_list;",
            "    mutable u64 random_state;",
            "",
            "    // 64-bit 整数でオーバーフローしない剰余乗算・累乗",
            "    static u64 mul_mod(u64 a, u64 b, u64 mod) {",
            "        return (u64)((u128)a * b % mod);",
            "    }",
            "",
            "    static u64 pow_mod(u64 a, u64 b, u64 mod) {",
            "        u64 result = 1;",
            "        while (b > 0) {",
            "            if (b & 1) result = mul_mod(result, a, mod);",
            "            a = mul_mod(a, a, mod);",
            "            b >>= 1;",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 64-bit 整数に対する決定的 Miller-Rabin 判定",
            "    static bool miller_rabin(u64 n) {",
            "        if (n < 2) return false;",
            "        for (u64 p : {2ULL, 3ULL, 5ULL, 7ULL, 11ULL, 13ULL, 17ULL, 19ULL, 23ULL, 29ULL, 31ULL, 37ULL}) {",
            "            if (n % p == 0) return n == p;",
            "        }",
            "",
            "        u64 d = n - 1;",
            "        int s = __builtin_ctzll(d);",
            "        d >>= s;",
            "        for (u64 a : {2ULL, 325ULL, 9375ULL, 28178ULL, 450775ULL, 9780504ULL, 1795265022ULL}) {",
            "            a %= n;",
            "            if (a == 0) continue;",
            "            u64 x = pow_mod(a, d, n);",
            "            if (x == 1 || x == n - 1) continue;",
            "            bool composite = true;",
            "            for (int i = 1; i < s; i++) {",
            "                x = mul_mod(x, x, n);",
            "                if (x == n - 1) {",
            "                    composite = false;",
            "                    break;",
            "                }",
            "            }",
            "            if (composite) return false;",
            "        }",
            "        return true;",
            "    }",
            "",
            "    // Pollard's Rho で使用する擬似乱数 (SplitMix64)",
            "    u64 next_random() const {",
            "        u64 x = (random_state += 0x9e3779b97f4a7c15ULL);",
            "        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;",
            "        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;",
            "        return x ^ (x >> 31);",
            "    }",
            "",
            "    // Brent 法による非自明な因数の探索 (n は合成数)",
            "    u64 pollard_rho(u64 n) const {",
            "        if (n % 2 == 0) return 2;",
            "        if (n % 3 == 0) return 3;",
            "        while (true) {",
            "            u64 y = next_random() % (n - 1) + 1;",
            "            u64 c = next_random() % (n - 1) + 1;",
            "            auto f = [&](u64 x) {",
            "                u64 z = mul_mod(x, x, n);",
            "                return z >= n - c ? z - (n - c) : z + c;",
            "            };",
            "",
            "            u64 g = 1, r = 1, q = 1, x = 0, ys = 0;",
            "            while (g == 1) {",
            "                x = y;",
            "                for (u64 i = 0; i < r; i++) y = f(y);",
            "                for (u64 k = 0; k < r && g == 1;) {",
            "                    ys = y;",
            "                    u64 len = min(128ULL, r - k);",
            "                    for (u64 i = 0; i < len; i++) {",
            "                        y = f(y);",
            "                        u64 delta = x > y ? x - y : y - x;",
            "                        q = mul_mod(q, delta, n);",
            "                    }",
            "                    g = gcd(q, n);",
            "                    k += len;",
            "                }",
            "                r *= 2;",
            "            }",
            "",
            "            if (g == n) {",
            "                do {",
            "                    ys = f(ys);",
            "                    u64 delta = x > ys ? x - ys : ys - x;",
            "                    g = gcd(delta, n);",
            "                } while (g == 1);",
            "            }",
            "            if (g != n) return g;",
            "        }",
            "    }",
            "",
            "    // 素因数を重複込みで求める",
            "    void factor_rec(u64 n, vector<u64>& factors) const {",
