            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to, cost) -> 新しい辺ID (前提: 有効な頂点、neg_inf < cost < inf)",
            "    int add_edge(int from, int to, T cost) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        assert(neg_inf < cost && cost < inf);",
            "        int id = edge_count++;",
            "        arcs.push_back({from, to, cost, id});",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // 無向辺追加: add_undirected_edge(u, v, cost) -> 両方向で共通の辺ID (前提: 有効な頂点、neg_inf < cost < inf)",
            "    int add_undirected_edge(int u, int v, T cost) {",
            "        assert(0 <= u && u < n && 0 <= v && v < n);",
            "        assert(neg_inf < cost && cost < inf);",
            "        int id = edge_count++;",
            "        arcs.push_back({u, v, cost, id});",
            "        arcs.push_back({v, u, cost, id});",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // 全点対最短距離: build() -> 負閉路がなければ true (前提: 有限な途中距離が (-inf, inf) に収まる)",
            "    bool build() {",
            "        built = false;",
            "        distance.assign(n, vector<T>(n, inf));",
            "        next_arc.assign(n, vector<int>(n, -1));",
            "        negative_cycle = false;",
            "        for (int i = 0; i < n; i++) distance[i][i] = T(0);",
            "",
            "        // 平行辺は最小コストの辺を選び、復元用の辺番号も記録する",
            "        for (int i = 0; i < (int)arcs.size(); i++) {",
            "            const Edge& e = arcs[i];",
            "            if (e.cost >= distance[e.from][e.to]) continue;",
            "            distance[e.from][e.to] = e.cost;",
            "            next_arc[e.from][e.to] = i;",
            "        }",
            "",
            "        // 中継点を順番に追加して最短距離と経路情報を更新する",
            "        for (int k = 0; k < n; k++) {",
            "            for (int i = 0; i < n; i++) {",
            "                if (distance[i][k] == inf) continue;",
            "                for (int j = 0; j < n; j++) {",
            "                    if (distance[k][j] == inf) continue;",
            "                    T d = add_cost(distance[i][k], distance[k][j]);",
            "                    if (d >= distance[i][j]) continue;",
            "                    distance[i][j] = d;",
            "                    next_arc[i][j] = (i == k ? next_arc[k][j] : next_arc[i][k]);",
            "                }",
            "            }",
            "        }",
            "",
            "        // 負閉路を通れる頂点対だけを -inf とし、経路復元を無効化する",
            "        for (int k = 0; k < n; k++) {",
            "            if (distance[k][k] >= T(0)) continue;",
            "            negative_cycle = true;",
            "            for (int i = 0; i < n; i++) {",
            "                if (distance[i][k] == inf) continue;",
            "                for (int j = 0; j < n; j++) {",
            "                    if (distance[k][j] == inf) continue;",
            "                    distance[i][j] = neg_inf;",
            "                    next_arc[i][j] = -1;",
            "                }",
            "            }",
            "        }",
            "        built = true;",
            "        return !negative_cycle;",
            "    }",
            "",
            "    // 最短距離: dist(u, v) -> 距離、到達不能なら inf、負閉路の影響下なら neg_inf (前提: build 済み、有効な頂点)",
            "    T dist(int u, int v) const {",
            "        assert(built && 0 <= u && u < n && 0 <= v && v < n);",
            "        return distance[u][v];",
            "    }",
            "",
            "    // 全最短距離: distances() -> 距離行列への参照 (前提: build 済み、再計算・辺追加後は再取得)",
            "    const vector<vector<T>>& distances() const {",
            "        assert(built);",
            "        return distance;",
            "    }",
            "",
            "    // 到達判定: reachable(u, v) -> u から v に到達できれば true (前提: build 済み、有効な頂点)",
            "    bool reachable(int u, int v) const {",
            "        assert(built && 0 <= u && u < n && 0 <= v && v < n);",
            "        return distance[u][v] != inf;",
            "    }",
            "",
            "    // 負閉路判定: has_negative_cycle() -> グラフに負閉路があれば true (前提: build 済み)",
            "    bool has_negative_cycle() const {",
            "        assert(built);",
            "        return negative_cycle;",
            "    }",
            "",
            "    // 頂点列復元: path(u, v) -> 最短経路の頂点列 (到達不能・負閉路の影響下なら空、前提: build 済み、有効な頂点)",
            "    vector<int> path(int u, int v) const {",
            "        assert(built && 0 <= u && u < n && 0 <= v && v < n);",
            "        if (!has_finite_path(u, v)) return {};",
            "        vector<int> result = {u};",
            "        int cur = u;",
            "        for (int step = 0; cur != v; step++) {",
            "            assert(step < n && next_arc[cur][v] != -1);",
            "            cur = arcs[next_arc[cur][v]].to;",
            "            result.push_back(cur);",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 辺列復元: edge_path(u, v) -> 最短経路の辺列 (到達不能・負閉路の影響下・u == v なら空、前提: build 済み、有効な頂点)",
            "    vector<Edge> edge_path(int u, int v) const {",
            "        assert(built && 0 <= u && u < n && 0 <= v && v < n);",
            "        if (!has_finite_path(u, v)) return {};",
            "        vector<Edge> result;",
            "        int cur = u;",
            "        for (int step = 0; cur != v; step++) {",
            "            assert(step < n && next_arc[cur][v] != -1);",
            "            const Edge& e = arcs[next_arc[cur][v]];",
            "            result.push_back(e);",
            "            cur = e.to;",
            "        }",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "LazySegmentTree": {
        "prefix": "!LazySegmentTree",
        "body": [
            "",
            "template<class S, S (*op)(S, S), S (*e)(), class F, S (*mapping)(F, S), F (*composition)(F, F), F (*id)()>",
            "struct LazySegmentTree {",
            "private:",
            "    int n;",
            "    int size;",
            "    int log;",
            "    vector<S> data;",
            "    vector<F> lazy;",
            "",
            "    // 子ノードを結合して親ノードを更新",
            "    void update(int k) {",
            "        data[k] = op(data[2 * k], data[2 * k + 1]);",
            "    }",
            "",
            "    // ノードに f を適用し、内部ノードの未伝播操作 g を composition(f, g) で更新 (g の後に f を適用)",
            "    void all_apply(int k, F f) {",
            "        data[k] = mapping(f, data[k]);",
            "        if (k < size) lazy[k] = composition(f, lazy[k]);",
            "    }",
            "",
            "    // 遅延操作を左右の子ノードへ伝播",
            "    void push(int k) {",
            "        all_apply(2 * k, lazy[k]);",
            "        all_apply(2 * k + 1, lazy[k]);",
            "        lazy[k] = id();",
            "    }",
            "",
            "public:",
            "    // 初期化: LazySegmentTree() -> 長さ0の配列を構築",
            "    LazySegmentTree() : LazySegmentTree(0) {}",
            "",
            "    // 初期化: LazySegmentTree(要素数) -> 全要素を e() に設定 (前提: 要素数 >= 0)",
            "    // op は結合則を満たし e() は単位元、mapping は op と両立し、composition は作用の合成、id() は恒等操作",
            "    // 区間和で S に区間長を持たせる場合、e() の長さは 0 なので、長さ 1 の要素を初期値とするには配列から構築する",
            "    LazySegmentTree(int element_count) : n(element_count), size(1), log(0) {",
            "        assert(element_count >= 0);",
            "",
            "        while (size < n) {",
            "            size *= 2;",
            "            log++;",
            "        }",
            "        data.assign(2 * size, e());",
            "        lazy.assign(size, id());",
            "    }",
            "",
            "    // 初期化: LazySegmentTree(初期配列) -> 配列の値から構築",
            "    // 使用例 (区間加算・区間和): S={sum,len}、F=long long、op は成分ごとの和、e()={0,0}",
            "    // mapping(f,x)={x.sum+f*x.len,x.len}、composition(f,g)=f+g、id()=0",
            "    // vector<S> v(n, S{0,1}); LazySegmentTree<S,op,e,F,mapping,composition,id> seg(v); seg.apply(0,n,5); seg.prod(0,n).sum;",
            "    LazySegmentTree(const vector<S>& v) : LazySegmentTree((int)v.size()) {",
            "        // 葉に初期値を配置し、下から親を構築",
            "        for (int i = 0; i < n; i++) {",
            "            data[size + i] = v[i];",
            "        }",
            "        for (int i = size - 1; i >= 1; i--) {",
            "            update(i);",
            "        }",
            "    }",
            "",
            "    // 点更新: set(位置 p, 値 x) -> a[p] を x に変更（0 <= p < n）",
            "    void set(int p, S x) {",
            "        assert(0 <= p && p < n);",
            "",
            "        p += size;",
            "        for (int i = log; i >= 1; i--) push(p >> i);",
            "        data[p] = x;",
            "        for (int i = 1; i <= log; i++) update(p >> i);",
            "    }",
            "",
            "    // 点取得: get(位置 p) -> a[p] を返す（0 <= p < n）",
            "    S get(int p) {",
            "        assert(0 <= p && p < n);",
            "",
            "        p += size;",
            "        for (int i = log; i >= 1; i--) push(p >> i);",
            "        return data[p];",
            "    }",
            "",
            "    // 区間取得: prod(左端 l, 右端 r) -> [l, r) の演算結果（0 <= l <= r <= n）",
            "    S prod(int l, int r) {",
            "        assert(0 <= l && l <= r && r <= n);",
            "        if (l == r) return e();",
            "",
            "        l += size;",
            "        r += size;",
            "        for (int i = log; i >= 1; i--) {",
            "            if (((l >> i) << i) != l) push(l >> i);",
            "            if (((r >> i) << i) != r) push((r - 1) >> i);",
            "        }",
            "",
            "        S left_value = e();",
            "        S right_value = e();",
            "        // 非可換演算でも結合順序を維持",
            "        while (l < r) {",
            "            if (l & 1) left_value = op(left_value, data[l++]);",
            "            if (r & 1) right_value = op(data[--r], right_value);",
            "            l >>= 1;",
            "            r >>= 1;",
            "        }",
            "        return op(left_value, right_value);",
            "    }",
            "",
            "    // 全区間取得: all_prod() -> [0, n) の演算結果を返す",
            "    S all_prod() const {",
            "        return data[1];",
            "    }",
            "",
            "    // 点作用: apply(位置 p, 操作 f) -> a[p] に f を適用（0 <= p < n）",
            "    void apply(int p, F f) {",
            "        assert(0 <= p && p < n);",
            "",
            "        p += size;",
            "        for (int i = log; i >= 1; i--) push(p >> i);",
            "        data[p] = mapping(f, data[p]);",
            "        for (int i = 1; i <= log; i++) update(p >> i);",
            "    }",
            "",
            "    // 区間作用: apply(左端 l, 右端 r, 操作 f) -> [l, r) に f を適用（0 <= l <= r <= n）",
            "    void apply(int l, int r, F f) {",
            "        assert(0 <= l && l <= r && r <= n);",
            "        if (l == r) return;",
            "",
            "        l += size;",
            "        r += size;",
            "        for (int i = log; i >= 1; i--) {",
            "            if (((l >> i) << i) != l) push(l >> i);",
            "            if (((r >> i) << i) != r) push((r - 1) >> i);",
            "        }",
            "",
            "        int left = l;",
            "        int right = r;",
            "        // 対象ノードに一括作用し、必要な祖先のみ更新",
            "        while (l < r) {",
            "            if (l & 1) all_apply(l++, f);",
            "            if (r & 1) all_apply(--r, f);",
            "            l >>= 1;",
            "            r >>= 1;",
            "        }",
            "        l = left;",
            "        r = right;",
            "        for (int i = 1; i <= log; i++) {",
            "            if (((l >> i) << i) != l) update(l >> i);",
            "            if (((r >> i) << i) != r) update((r - 1) >> i);",
            "        }",
            "    }",
            "",
            "    // 右方向の二分探索: max_right(左端 l, 判定関数 g) -> g(prod(l, r)) が true の最大の r",
            "    // 前提: 0 <= l <= n、g(e()) == true、g に副作用がなく判定が単調",
            "    template<class G>",
            "    int max_right(int l, G g) {",
            "        assert(0 <= l && l <= n);",
            "        assert(g(e()));",
            "        if (l == n) return n;",
            "",
            "        l += size;",
            "        for (int i = log; i >= 1; i--) push(l >> i);",
            "        S value = e();",
            "        do {",
            "            while ((l & 1) == 0) l >>= 1;",
            "            if (!g(op(value, data[l]))) {",
            "                // 条件が初めて破れる葉まで遅延操作を伝播しながら降りる",
            "                while (l < size) {",
            "                    push(l);",
            "                    l *= 2;",
            "                    if (g(op(value, data[l]))) {",
            "                        value = op(value, data[l]);",
            "                        l++;",
            "                    }",
            "                }",
            "                return l - size;",
            "            }",
            "            value = op(value, data[l]);",
            "            l++;",
            "        } while ((l & -l) != l);",
            "        return n;",
            "    }",
            "",
            "    // 左方向の二分探索: min_left(右端 r, 判定関数 g) -> g(prod(l, r)) が true の最小の l",
            "    // 前提: 0 <= r <= n、g(e()) == true、g に副作用がなく判定が単調",
            "    template<class G>",
            "    int min_left(int r, G g) {",
            "        assert(0 <= r && r <= n);",
            "        assert(g(e()));",
            "        if (r == 0) return 0;",
            "",
            "        r += size;",
            "        for (int i = log; i >= 1; i--) push((r - 1) >> i);",
            "        S value = e();",
            "        do {",
            "            r--;",
            "            while (r > 1 && (r & 1)) r >>= 1;",
            "            if (!g(op(data[r], value))) {",
            "                // 条件が初めて破れる葉まで遅延操作を伝播しながら降りる",
            "                while (r < size) {",
            "                    push(r);",
            "                    r = 2 * r + 1;",
            "                    if (g(op(data[r], value))) {",
            "                        value = op(data[r], value);",
            "                        r--;",
            "                    }",
            "                }",
            "                return r + 1 - size;",
            "            }",
            "            value = op(data[r], value);",
            "        } while ((r & -r) != r);",
            "        return 0;",
            "    }",
            "};",
            ""
        ]
    },
    "IntervalSet": {
        "prefix": "!IntervalSet",
        "body": [
            "",
            "struct IntervalSet {",
            "private:",
            "    set<pair<long long, long long>> data;",
            "    long long covered_length_value;",
            "",
            "public:",
            "    // 初期化: IntervalSet() -> 空の整数区間集合を生成",
            "    IntervalSet() : covered_length_value(0) {}",
            "",
            "    // 区間追加: insert(l, r) -> [l, r) を追加し、新しく加わった整数の個数を返す",
            "    // 前提: l <= r、更新後の登録整数の総数が long long で表現可能",
            "    long long insert(long long l, long long r) {",
            "        assert(l <= r);",
            "        if (l == r) return 0;",
            "",
            "        auto it = data.lower_bound({l, LLONG_MIN});",
            "        if (it != data.begin() && prev(it)->second >= l) --it;",
            "        auto first = it;",
            "",
            "        long long new_l = l, new_r = r;",
            "        __int128 erased_length = 0;",
            "",
            "        // 重なる区間・隣接する区間をまとめて1区間にする",
            "        while (it != data.end() && it->first <= new_r) {",
            "            new_l = min(new_l, it->first);",
            "            new_r = max(new_r, it->second);",
            "            erased_length += (__int128)it->second - it->first;",
            "            ++it;",
            "        }",
            "",
            "        __int128 added = (__int128)new_r - new_l - erased_length;",
            "        assert(0 <= added && (__int128)covered_length_value + added <= LLONG_MAX);",
            "",
            "        data.erase(first, it);",
            "        data.emplace(new_l, new_r);",
            "        covered_length_value += (long long)added;",
            "        return (long long)added;",
            "    }",
            "",
            "    // 区間削除: erase(l, r) -> [l, r) を削除し、実際に取り除いた整数の個数を返す",
            "    // 前提: l <= r",
            "    long long erase(long long l, long long r) {",
            "        assert(l <= r);",
            "        if (l == r) return 0;",
            "",
            "        auto it = data.lower_bound({l, LLONG_MIN});",
            "        if (it != data.begin() && prev(it)->second > l) --it;",
            "        auto first = it;",
            "",
            "        __int128 removed = 0;",
            "        optional<pair<long long, long long>> left_part, right_part;",
            "",
            "        // 削除対象との共通部分を取り除き、残る両端を保持する",
            "        while (it != data.end() && it->first < r) {",
            "            long long a = it->first, b = it->second;",
            "            long long x = max(l, a), y = min(r, b);",
            "            if (x < y) removed += (__int128)y - x;",
            "            if (a < l) left_part = pair<long long, long long>{a, l};",
            "            if (r < b) right_part = pair<long long, long long>{r, b};",
            "            ++it;",
            "        }",
            "",
            "        data.erase(first, it);",
            "        if (left_part) data.insert(*left_part);",
            "        if (right_part) data.insert(*right_part);",
            "        covered_length_value -= (long long)removed;",
            "        return (long long)removed;",
            "    }",
            "",
            "    // 全削除: clear() -> 登録されている全区間を削除",
            "    void clear() {",
            "        data.clear();",
            "        covered_length_value = 0;",
            "    }",
            "",
            "    // 整数包含判定: contains(x) -> x が登録されていれば true",
            "    bool contains(long long x) const {",
            "        return find(x).has_value();",
            "    }",
            "",
            "    // 区間包含判定: contains(l, r) -> [l, r) の全整数が登録されていれば true",
            "    // 前提: l <= r (空区間は常に true)",
            "    bool contains(long long l, long long r) const {",
            "        assert(l <= r);",
            "        if (l == r) return true;",
            "        auto interval = find(l);",
            "        return interval && r <= interval->second;",
            "    }",
            "",
            "    // 所属区間取得: find(x) -> x を含む [l, r)、存在しなければ nullopt",
            "    optional<pair<long long, long long>> find(long long x) const {",
            "        auto it = data.upper_bound({x, LLONG_MAX});",
            "        if (it == data.begin()) return nullopt;",
            "        --it;",
            "        if (x >= it->second) return nullopt;",
            "        return *it;",
            "    }",
            "",
            "    // 未登録整数検索: mex(x) -> x 以上で登録されていない最小の整数",
            "    long long mex(long long x) const {",
            "        auto interval = find(x);",
            "        return interval ? interval->second : x;",
            "    }",
            "",
            "    // 区間数取得: size() -> 登録されている区間の個数",
            "    int size() const {",
            "        return (int)data.size();",
            "    }",
            "",
            "    // 空集合判定: empty() -> 登録区間が1つもなければ true",
            "    bool empty() const {",
            "        return data.empty();",
            "    }",
            "",
            "    // 登録整数の総数取得: covered_length() -> 各区間の長さの合計",
            "    long long covered_length() const {",
            "        return covered_length_value;",
            "    }",
            "",
            "    // 指定範囲の登録整数数取得: covered_length(l, r) -> [l, r) 内の登録整数数",
            "    // 前提: l <= r",
            "    long long covered_length(long long l, long long r) const {",
            "        assert(l <= r);",
            "        if (l == r) return 0;",
            "",
            "        auto it = data.lower_bound({l, LLONG_MIN});",
            "        if (it != data.begin() && prev(it)->second > l) --it;",
            "",
            "        __int128 result = 0;",
            "        // 対象範囲に重なる登録区間のみ走査する",
            "        while (it != data.end() && it->first < r) {",
            "            long long left = max(l, it->first);",
            "            long long right = min(r, it->second);",
            "            if (left < right) result += (__int128)right - left;",
            "            ++it;",
            "        }",
            "        return (long long)result;",
            "    }",
            "",
            "    // 共通部分取得: intersections(l, r) -> [l, r) と登録区間の共通部分一覧",
            "    // 前提: l <= r（左端の昇順、半開区間）",
            "    vector<pair<long long, long long>> intersections(long long l, long long r) const {",
            "        assert(l <= r);",
            "        vector<pair<long long, long long>> result;",
            "        if (l == r) return result;",
            "",
            "        auto it = data.lower_bound({l, LLONG_MIN});",
            "        if (it != data.begin() && prev(it)->second > l) --it;",
            "",
            "        // 各登録区間を [l, r) で切り取り、空でない部分のみ取得する",
            "        while (it != data.end() && it->first < r) {",
            "            long long left = max(l, it->first);",
            "            long long right = min(r, it->second);",
            "            if (left < right) result.emplace_back(left, right);",
            "            ++it;",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 未登録部分取得: gaps(l, r) -> [l, r) 内の未登録区間一覧",
            "    // 前提: l <= r（左端の昇順、半開区間）",
            "    vector<pair<long long, long long>> gaps(long long l, long long r) const {",
            "        assert(l <= r);",
            "        vector<pair<long long, long long>> result;",
            "        if (l == r) return result;",
            "",
            "        auto it = data.lower_bound({l, LLONG_MIN});",
            "        if (it != data.begin() && prev(it)->second > l) --it;",
            "",
            "        long long current = l;",
            "        // 登録区間の直前にある空きを列挙する",
            "        while (it != data.end() && it->first < r) {",
            "            long long left = max(l, it->first);",
            "            long long right = min(r, it->second);",
            "            if (current < left) result.emplace_back(current, left);",
            "            if (current < right) current = right;",
            "            ++it;",
            "        }",
            "        if (current < r) result.emplace_back(current, r);",
            "        return result;",
            "    }",
            "",
            "    // 全区間取得: intervals() -> [l, r) の一覧を左端昇順で返す",
            "    vector<pair<long long, long long>> intervals() const {",
            "        return vector<pair<long long, long long>>(data.begin(), data.end());",
            "    }",
            "};",
            ""
        ]
    },
    "Doubling": {
        "prefix": "!Doubling",
        "body": [
            "",
            "struct Doubling {",
            "private:",
            "    int n;",
            "    long long limit;",
            "    bool has_sum;",
            "    vector<vector<int>> table;",
            "    vector<vector<long long>> sum_table;",
            "",
            "    // 遷移先を 2^j 回分まとめて前計算する",
            "    template<class T>",
            "    void build_next(const vector<T>& next) {",
            "        static_assert(is_integral_v<T> && is_signed_v<T> && sizeof(T) <= sizeof(long long), \"next must contain signed integers of at most 64 bits\");",
            "        assert(next.size() <= (size_t)INT_MAX && limit >= 0);",
            "        n = (int)next.size();",
            "        int log = 1;",
            "        while ((limit >> log) != 0) log++;",
            "        table.assign(log, vector<int>(n, -1));",
            "",
            "        for (int v = 0; v < n; v++) {",
            "            assert(next[v] == -1 || (0 <= next[v] && next[v] < n));",
            "            table[0][v] = (int)next[v];",
            "        }",
            "        for (int j = 1; j < log; j++) {",
            "            for (int v = 0; v < n; v++) {",
            "                int to = table[j - 1][v];",
            "                if (to != -1) table[j][v] = table[j - 1][to];",
            "            }",
            "        }",
            "    }",
            "",
            "    // 重み付きの場合だけ集約テーブルを構築する",
            "    template<class T, class U>",
            "    void build_weighted(const vector<T>& next, const vector<U>& value) {",
            "        static_assert(is_integral_v<U> && is_signed_v<U> && sizeof(U) <= sizeof(long long), \"value must contain signed integers of at most 64 bits\");",
            "        assert(next.size() == value.size());",
            "        build_next(next);",
            "        sum_table.assign(table.size(), vector<long long>(n, 0));",
            "        for (int v = 0; v < n; v++) sum_table[0][v] = (long long)value[v];",
            "",
            "        // sum_table[j][v]: v から最大 2^j 個の頂点の重みの和 (遷移終了で打ち切り)",
            "        for (int j = 1; j < (int)table.size(); j++) {",
            "            for (int v = 0; v < n; v++) {",
            "                int to = table[j - 1][v];",
            "                __int128 total = (__int128)sum_table[j - 1][v];",
            "                if (to != -1) total += sum_table[j - 1][to];",
            "                assert(LLONG_MIN <= total && total <= LLONG_MAX);",
            "                sum_table[j][v] = (long long)total;",
            "            }",
            "        }",
            "    }",
            "",
            "public:",
            "    // 初期化: Doubling(next, max_step) -> 遷移先のみを構築 (-1 は遷移終了)",
            "    // 前提: next は符号付き整数配列、next[v] は -1 または [0, N)、max_step >= 0",
            "    Doubling(const vector<int>& next, long long max_step = (1LL << 60) - 1)",
            "        : n(0), limit(max_step), has_sum(false) {",
            "        build_next(next);",
            "    }",
            "",
            "    // 初期化: Doubling(next, max_step) -> long long などの符号付き整数配列に対応",
            "    // 前提: next[v] は -1 または [0, N)、max_step >= 0",
            "    template<class T>",
            "    Doubling(const vector<T>& next, long long max_step = (1LL << 60) - 1)",
            "        : n(0), limit(max_step), has_sum(false) {",
            "        build_next(next);",
            "    }",
            "",
            "    // 初期化リストでも使える重み付き初期化 (next は int、value は long long)",
            "    // 前提: value は next と同じ長さ、各集約和は long long に収まる",
            "    Doubling(const vector<int>& next, const vector<long long>& value, long long max_step)",
            "        : n(0), limit(max_step), has_sum(true) {",
            "        build_weighted(next, value);",
            "    }",
            "",
            "    // 重み付き初期化: next と value は int / long long などの符号付き整数配列",
            "    // 前提: next と value は同じ長さ、各集約和は long long に収まる",
            "    template<class T, class U>",
            "    Doubling(const vector<T>& next, const vector<U>& value, long long max_step)",
            "        : n(0), limit(max_step), has_sum(true) {",
            "        build_weighted(next, value);",
            "    }",
            "",
            "    // k 回遷移: jump(v, k) -> k 回後の頂点 (途中で遷移が終了したら -1)",
            "    // 前提: 0 <= v < N、0 <= k <= max_step",
            "    int jump(int v, long long k) const {",
            "        assert(0 <= v && v < n);",
            "        assert(0 <= k && k <= limit);",
            "",
            "        for (int j = 0; k > 0; j++, k >>= 1) {",
            "            if (k & 1) {",
            "                v = table[j][v];",
            "                if (v == -1) return -1;",
            "            }",
            "        }",
            "        return v;",
            "    }",
            "",
            "    // 重みの和: sum(v, k) -> v から始めて k 個の頂点の重みの和 (遷移終了で打ち切り)",
            "    // 前提: 重み付き初期化済み、0 <= v < N、0 <= k <= max_step、和は long long に収まる",
            "    long long sum(int v, long long k) const {",
            "        assert(has_sum && 0 <= v && v < n);",
            "        assert(0 <= k && k <= limit);",
            "        long long result = 0;",
            "",
            "        for (int j = 0; k > 0; j++, k >>= 1) {",
            "            if (k & 1) {",
            "                __int128 total = (__int128)result + sum_table[j][v];",
            "                assert(LLONG_MIN <= total && total <= LLONG_MAX);",
            "                result = (long long)total;",
            "                v = table[j][v];",
            "                if (v == -1) break;",
            "            }",
            "        }",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "CycleDetection": {
        "prefix": "!CycleDetection",
        "body": [
            "",
            "struct CycleDetection {",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        int id;",
            "    };",
            "",
            "private:",
            "    struct Arc {",
            "        int to;",
            "        int id;",
            "    };",
            "",
            "    int n;",
            "    int edge_count;",
            "    bool directed;",
            "    bool built;",
            "    bool found;",
            "    vector<vector<Arc>> graph;",
            "    vector<int> vertices;",
            "    vector<Edge> edges;",
            "",
            "public:",
            "    // 初期化: CycleDetection(n, directed) -> n 頂点の有向/無向グラフ (前提: n >= 0)",
            "    CycleDetection(int vertex_count, bool is_directed)",
            "        : n(vertex_count), edge_count(0), directed(is_directed), built(false), found(false) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "    }",
            "",
            "    // 辺追加: add_edge(from, to) -> 新しい辺ID (前提: 頂点が有効、無向なら両方向に登録)",
            "    int add_edge(int from, int to) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        int id = edge_count++;",
            "        graph[from].push_back({to, id});",
            "        if (!directed) graph[to].push_back({from, id});",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // サイクル探索: build() -> サイクルが存在すれば true (長さ1の自己ループ、無向の平行辺も対象)",
            "    bool build() {",
            "        built = false;",
            "        found = false;",
            "        vertices.clear();",
            "        edges.clear();",
            "        vector<int> state(n, 0), parent(n, -1), parent_edge(n, -1), index(n, 0);",
            "        vector<int> stack;",
            "        stack.reserve(n);",
            "",
            "        // 再帰を使わないDFSで探索中の祖先への辺を見つける",
            "        for (int root = 0; root < n; root++) {",
            "            if (state[root] != 0) continue;",
            "            state[root] = 1;",
            "            stack.push_back(root);",
            "            while (!stack.empty()) {",
            "                int v = stack.back();",
            "                if (index[v] == (int)graph[v].size()) {",
            "                    state[v] = 2;",
            "                    stack.pop_back();",
            "                    continue;",
            "                }",
            "                Arc a = graph[v][index[v]++];",
            "                if (!directed && a.id == parent_edge[v]) continue;",
            "                if (state[a.to] == 0) {",
            "                    parent[a.to] = v;",
            "                    parent_edge[a.to] = a.id;",
            "                    state[a.to] = 1;",
            "                    stack.push_back(a.to);",
            "                } else if (state[a.to] == 1) {",
            "                    // 祖先から現在頂点までの木辺と、祖先へ戻る辺を復元する",
            "                    for (int cur = v; cur != a.to; cur = parent[cur]) vertices.push_back(cur);",
            "                    vertices.push_back(a.to);",
            "                    reverse(vertices.begin(), vertices.end());",
            "                    for (int i = 1; i < (int)vertices.size(); i++) {",
            "                        int u = vertices[i - 1], to = vertices[i];",
            "                        edges.push_back({u, to, parent_edge[to]});",
            "                    }",
            "                    edges.push_back({v, a.to, a.id});",
            "                    found = true;",
            "                    built = true;",
            "                    return true;",
            "                }",
            "            }",
            "        }",
            "        built = true;",
            "        return false;",
            "    }",
            "",
            "    // 存在判定: has_cycle() -> サイクルが見つかっていれば true (前提: build 済み)",
            "    bool has_cycle() const {",
            "        assert(built);",
            "        return found;",
            "    }",
            "",
            "    // 頂点列復元: cycle_vertices() -> 閉路上の頂点列 (閉路なしなら空、前提: build 済み)",
            "    vector<int> cycle_vertices() const {",
            "        assert(built);",
            "        return vertices;",
            "    }",
            "",
            "    // 辺列復元: cycle_edges() -> 頂点列と同じ順の辺列 (閉路なしなら空、前提: build 済み)",
            "    vector<Edge> cycle_edges() const {",
            "        assert(built);",
            "        return edges;",
            "    }",
            "};",
            ""
        ]
    },
    "MaxFlow": {
        "prefix": "!MaxFlow",
        "body": [
            "",
            "template<class T = long long>",
            "struct MaxFlow {",
            "    static_assert(is_integral_v<T> && !is_same_v<T, bool>, \"T must be an integer type\");",
            "",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        T cap;",
            "        T flow;",
            "    };",
            "",
            "private:",
            "    struct ResidualEdge {",
            "        int to;",
            "        int rev;",
            "        T cap;",
            "    };",
            "",
            "    int n;",
            "    vector<vector<ResidualEdge>> graph;",
            "    vector<pair<int, int>> pos;",
            "",
            "    // レベルグラフを構築し、終点への到達可能性を返す",
            "    bool bfs(int s, int t, vector<int>& level) const {",
            "        fill(level.begin(), level.end(), -1);",
            "        queue<int> que;",
            "        level[s] = 0;",
            "        que.push(s);",
            "        while (!que.empty()) {",
            "            int v = que.front();",
            "            que.pop();",
            "            for (const ResidualEdge& e : graph[v]) {",
            "                if (e.cap == T(0) || level[e.to] != -1) continue;",
            "                level[e.to] = level[v] + 1;",
            "                que.push(e.to);",
            "            }",
            "        }",
            "        return level[t] != -1;",
            "    }",
            "",
            "    // 再帰を使わず、レベルグラフ上の増加路に流せる量を求めて流す",
            "    T augment(int s, int t, T limit, const vector<int>& level, vector<int>& iter,",
            "              vector<int>& vertices, vector<int>& edge_indices, vector<T>& minimum) {",
            "        vertices.clear();",
            "        edge_indices.clear();",
            "        minimum.clear();",
            "        vertices.push_back(s);",
            "        minimum.push_back(limit);",
            "",
            "        while (!vertices.empty()) {",
            "            int v = vertices.back();",
            "            if (v == t) {",
            "                T pushed = minimum.back();",
            "                for (int i = 0; i < (int)edge_indices.size(); i++) {",
            "                    ResidualEdge& e = graph[vertices[i]][edge_indices[i]];",
            "                    e.cap -= pushed;",
            "                    graph[e.to][e.rev].cap += pushed;",
            "                }",
            "                return pushed;",
            "            }",
            "",
            "            int& i = iter[v];",
            "            while (i < (int)graph[v].size()) {",
            "                const ResidualEdge& e = graph[v][i];",
            "                if (e.cap > T(0) && level[e.to] == level[v] + 1) break;",
            "                i++;",
            "            }",
            "            if (i == (int)graph[v].size()) {",
            "                vertices.pop_back();",
            "                minimum.pop_back();",
            "                if (vertices.empty()) break;",
            "                edge_indices.pop_back();",
            "                iter[vertices.back()]++;",
            "            } else {",
            "                const ResidualEdge& e = graph[v][i];",
            "                T next_min = min(minimum.back(), e.cap);",
            "                edge_indices.push_back(i);",
            "                vertices.push_back(e.to);",
            "                minimum.push_back(next_min);",
            "            }",
            "        }",
            "        return T(0);",
            "    }",
            "",
            "public:",
            "    // 初期化: MaxFlow(n) -> n 頂点の空グラフ (前提: n >= 0)",
            "    MaxFlow(int vertex_count) : n(vertex_count) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to, cap) -> 追加した辺ID (前提: 頂点が有効、cap >= 0)",
            "    int add_edge(int from, int to, T cap) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        assert(cap >= T(0));",
            "        int id = (int)pos.size();",
            "        int from_id = (int)graph[from].size();",
            "        int to_id = (int)graph[to].size();",
            "        if (from == to) to_id++;",
            "        pos.push_back({from, from_id});",
            "        graph[from].push_back({to, to_id, cap});",
            "        graph[to].push_back({from, from_id, T(0)});",
            "        return id;",
            "    }",
            "",
            "    // 追加最大流: flow(s, t) -> 残余グラフ上で追加可能な最大流量 (前提: s, t が有効、s != t、総流量が T に収まる)",
            "    T flow(int s, int t) {",
            "        return flow(s, t, numeric_limits<T>::max());",
            "    }",
            "",
            "    // 流量制限付き追加最大流: flow(s, t, limit) -> 追加流量 (前提: s, t が有効、s != t、limit >= 0)",
            "    T flow(int s, int t, T limit) {",
            "        assert(0 <= s && s < n && 0 <= t && t < n && s != t);",
            "        assert(limit >= T(0));",
            "        T result = T(0);",
            "        vector<int> level(n), iter(n);",
            "        vector<int> vertices, edge_indices;",
            "        vector<T> minimum;",
            "        vertices.reserve(n);",
            "        edge_indices.reserve(n);",
            "        minimum.reserve(n);",
            "",
            "        while (result < limit && bfs(s, t, level)) {",
            "            fill(iter.begin(), iter.end(), 0);",
            "            while (result < limit) {",
            "                T pushed = augment(s, t, limit - result, level, iter, vertices, edge_indices, minimum);",
            "                if (pushed == T(0)) break;",
            "                result += pushed;",
            "            }",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 辺取得: get_edge(i) -> 辺ID i の始点・終点・容量・流量 (前提: 0 <= i < 辺数)",
            "    Edge get_edge(int i) const {",
            "        assert(0 <= i && i < (int)pos.size());",
            "        auto [from, index] = pos[i];",
            "        const ResidualEdge& e = graph[from][index];",
            "        const ResidualEdge& rev = graph[e.to][e.rev];",
            "        return {from, e.to, e.cap + rev.cap, rev.cap};",
            "    }",
            "",
            "    // 全辺取得: edges() -> 辺ID順の辺情報の配列",
            "    vector<Edge> edges() const {",
            "        vector<Edge> result;",
            "        result.reserve(pos.size());",
            "        for (int i = 0; i < (int)pos.size(); i++) result.push_back(get_edge(i));",
            "        return result;",
            "    }",
            "",
            "    // 最小カット側の頂点判定: min_cut(s) -> 残余グラフで s から到達可能な頂点",
            "    // 前提: s が有効。s-t 最小カットとして使う場合は最大流を流し切る必要がある (流量制限付き flow の途中では t を含む場合がある)",
            "    vector<bool> min_cut(int s) const {",
            "        assert(0 <= s && s < n);",
            "        vector<bool> visited(n, false);",
            "        queue<int> que;",
            "        visited[s] = true;",
            "        que.push(s);",
            "        while (!que.empty()) {",
            "            int v = que.front();",
            "            que.pop();",
            "            for (const ResidualEdge& e : graph[v]) {",
            "                if (e.cap == T(0) || visited[e.to]) continue;",
            "                visited[e.to] = true;",
            "                que.push(e.to);",
            "            }",
            "        }",
            "        return visited;",
            "    }",
            "",
            "    // 辺変更: change_edge(i, cap, flow) -> 辺ID i の容量・流量を変更 (前提: 0 <= flow <= cap、実行可能流の維持は呼び出し側の責任)",
            "    void change_edge(int i, T new_cap, T new_flow) {",
            "        assert(0 <= i && i < (int)pos.size());",
            "        assert(T(0) <= new_flow && new_flow <= new_cap);",
            "        auto [from, index] = pos[i];",
            "        ResidualEdge& e = graph[from][index];",
            "        ResidualEdge& rev = graph[e.to][e.rev];",
            "        e.cap = new_cap - new_flow;",
            "        rev.cap = new_flow;",
            "    }",
            "};",
            ""
        ]
    },
    "MinCostFlow": {
        "prefix": "!MinCostFlow",
        "body": [
            "",
            "template<class Cap = long long, class Cost = long long>",
            "struct MinCostFlow {",
            "    static_assert(is_integral_v<Cap> && !is_same_v<Cap, bool>, \"Cap must be an integer type\");",
            "    static_assert(is_integral_v<Cost> && is_signed_v<Cost>, \"Cost must be a signed integer type\");",
            "",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        Cap cap;",
            "        Cap flow;",
            "        Cost cost;",
            "    };",
            "",
            "private:",
            "    using Wide = __int128_t;",
            "",
            "    struct ResidualEdge {",
            "        int to;",
            "        int rev;",
            "        Cap cap;",
            "        Cost cost;",
            "    };",
            "",
            "    int n;",
            "    int source, sink;",
            "    vector<vector<ResidualEdge>> graph;",
            "    vector<pair<int, int>> pos;",
            "    vector<Wide> potential;",
            "",
            "    // 現在の残余グラフから追加流量を求める（slope が必要な場合は履歴も記録）",
            "    pair<Cap, Cost> run(int s, int t, Cap limit, vector<pair<Cap, Cost>>* history) {",
            "        assert(0 <= s && s < n && 0 <= t && t < n && s != t);",
            "        assert(limit >= Cap(0));",
            "        if (source == -1) {",
            "            source = s;",
            "            sink = t;",
            "        } else {",
            "            assert(s == source && t == sink);",
            "        }",
            "",
            "        if (history) history->push_back({Cap(0), Cost(0)});",
            "        Cap total_flow = Cap(0);",
            "        Cost total_cost = Cost(0);",
            "        Wide last_unit_cost = 0;",
            "        bool has_last = false;",
            "        const Wide inf = Wide(1) << 120;",
            "        vector<Wide> dist(n);",
            "        vector<int> prev_vertex(n), prev_edge(n);",
            "",
            "        while (total_flow < limit) {",
            "            fill(dist.begin(), dist.end(), inf);",
            "            fill(prev_vertex.begin(), prev_vertex.end(), -1);",
            "            priority_queue<pair<Wide, int>, vector<pair<Wide, int>>,",
            "                           greater<pair<Wide, int>>> pq;",
            "            dist[s] = 0;",
            "            pq.push({0, s});",
            "",
            "            // ポテンシャルで非負に再重み付けし、最短増加路を探索する",
            "            while (!pq.empty()) {",
            "                auto [d, v] = pq.top();",
            "                pq.pop();",
            "                if (d != dist[v]) continue;",
            "                for (int i = 0; i < (int)graph[v].size(); i++) {",
            "                    const ResidualEdge& e = graph[v][i];",
            "                    if (e.cap == Cap(0)) continue;",
            "                    Wide reduced_cost = Wide(e.cost) + potential[v] - potential[e.to];",
            "                    assert(reduced_cost >= 0);",
            "                    Wide next_dist = d + reduced_cost;",
            "                    if (next_dist >= dist[e.to]) continue;",
            "                    dist[e.to] = next_dist;",
            "                    prev_vertex[e.to] = v;",
            "                    prev_edge[e.to] = i;",
            "                    pq.push({next_dist, e.to});",
            "                }",
            "            }",
            "            if (dist[t] == inf) break;",
            "",
            "            // 更新後のポテンシャル差が、今回の単位流量あたりの費用となる",
            "            for (int v = 0; v < n; v++) {",
            "                if (dist[v] != inf) potential[v] += dist[v];",
            "            }",
            "            Wide unit_cost = potential[t] - potential[s];",
            "            assert(0 <= unit_cost && unit_cost <= Wide(numeric_limits<Cost>::max()));",
            "",
            "            Cap pushed = limit - total_flow;",
            "            for (int v = t; v != s; v = prev_vertex[v]) {",
            "                const ResidualEdge& e = graph[prev_vertex[v]][prev_edge[v]];",
            "                pushed = min(pushed, e.cap);",
            "            }",
            "",
            "            // 総費用が Cost に収まることを確認してから残余容量を更新する",
            "            Wide next_cost = Wide(total_cost) + Wide(pushed) * unit_cost;",
            "            assert(next_cost <= Wide(numeric_limits<Cost>::max()));",
            "            for (int v = t; v != s; v = prev_vertex[v]) {",
            "                ResidualEdge& e = graph[prev_vertex[v]][prev_edge[v]];",
            "                e.cap -= pushed;",
            "                graph[v][e.rev].cap += pushed;",
            "            }",
            "            total_flow += pushed;",
            "            total_cost = Cost(next_cost);",
            "",
            "            // 傾きが等しい連続区間は1本の線分としてまとめる",
            "            if (history) {",
            "                if (has_last && last_unit_cost == unit_cost) history->pop_back();",
            "                history->push_back({total_flow, total_cost});",
            "            }",
            "            last_unit_cost = unit_cost;",
            "            has_last = true;",
            "        }",
            "        return {total_flow, total_cost};",
            "    }",
            "",
            "public:",
            "    // 初期化: MinCostFlow(n) -> n 頂点の空グラフ (前提: n >= 0)",
            "    MinCostFlow(int vertex_count) : n(vertex_count), source(-1), sink(-1) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "        potential.assign(n, 0);",
            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to, cap, cost) -> 辺ID (前提: 頂点が有効、cap >= 0、cost >= 0、流量計算前)",
            "    int add_edge(int from, int to, Cap cap, Cost cost) {",
            "        assert(source == -1);",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        assert(cap >= Cap(0) && cost >= Cost(0));",
            "        int id = (int)pos.size();",
            "        int from_id = (int)graph[from].size();",
            "        int to_id = (int)graph[to].size();",
            "        if (from == to) to_id++;",
            "        pos.push_back({from, from_id});",
            "        graph[from].push_back({to, to_id, cap, cost});",
            "        graph[to].push_back({from, from_id, Cap(0), Cost(-cost)});",
            "        return id;",
            "    }",
            "",
            "    // 追加最小費用最大流: flow(s, t) -> 現在の残余グラフから追加した {流量, 追加費用} (前提: s != t、以後も同じ s, t)",
            "    pair<Cap, Cost> flow(int s, int t) {",
            "        return flow(s, t, numeric_limits<Cap>::max());",
            "    }",
            "",
            "    // 流量制限付き: flow(s, t, limit) -> limit 以下で今回追加した {流量, 追加費用} (前提: limit >= 0、同じ s, t)",
            "    pair<Cap, Cost> flow(int s, int t, Cap limit) {",
            "        return run(s, t, limit, nullptr);",
            "    }",
            "",
            "    // 追加費用曲線: slope(s, t) -> 現在の残余グラフから追加可能な流量と追加費用の折れ線頂点 (前提: 同じ s, t)",
            "    // 対応する流量を実際に追加し、返り値は今回の追加分のみを表す",
            "    vector<pair<Cap, Cost>> slope(int s, int t) {",
            "        return slope(s, t, numeric_limits<Cap>::max());",
            "    }",
            "",
            "    // 流量制限付き費用曲線: slope(s, t, limit) -> {0,0} から始まる今回の追加流量と追加費用の折れ線頂点",
            "    // 前提: limit >= 0、同じ s, t。例: flow(s,t,2) の後の slope(s,t,3) は、さらに最大3流す分のみを返す",
            "    vector<pair<Cap, Cost>> slope(int s, int t, Cap limit) {",
            "        vector<pair<Cap, Cost>> result;",
            "        run(s, t, limit, &result);",
            "        return result;",
            "    }",
            "",
            "    // 辺取得: get_edge(i) -> 辺ID i の始点・終点・容量・流量・コスト (前提: 0 <= i < 辺数)",
            "    Edge get_edge(int i) const {",
            "        assert(0 <= i && i < (int)pos.size());",
            "        auto [from, index] = pos[i];",
            "        const ResidualEdge& e = graph[from][index];",
            "        const ResidualEdge& rev = graph[e.to][e.rev];",
            "        return {from, e.to, e.cap + rev.cap, rev.cap, e.cost};",
            "    }",
            "",
            "    // 全辺取得: edges() -> 辺ID順の辺情報の配列",
            "    vector<Edge> edges() const {",
            "        vector<Edge> result;",
            "        result.reserve(pos.size());",
            "        for (int i = 0; i < (int)pos.size(); i++) result.push_back(get_edge(i));",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "ProjectSelection": {
        "prefix": "!ProjectSelection",
        "body": [
            "",
            "template<class T = long long>",
            "struct ProjectSelection {",
            "    static_assert(is_integral_v<T> && is_signed_v<T> && sizeof(T) <= 8,",
            "                  \"T must be a signed integer type of at most 64 bits\");",
            "",
            "public:",
            "    struct Result {",
            "        T value;",
            "        vector<bool> selected;",
            "        bool feasible;",
            "    };",
            "",
            "private:",
            "    using Wide = __int128_t;",
            "    static constexpr int SOURCE = -1;",
            "    static constexpr int SINK = -2;",
            "",
            "    struct Request {",
            "        int from;",
            "        int to;",
            "        Wide cap;",
            "        bool hard;",
            "    };",
            "",
            "    struct Dinic {",
            "        struct Edge {",
            "            int to;",
            "            int rev;",
            "            Wide cap;",
            "        };",
            "",
            "        vector<vector<Edge>> graph;",
            "",
            "        Dinic(int n) : graph(n) {}",
            "",
            "        void add_edge(int from, int to, Wide cap) {",
            "            assert(cap >= 0);",
            "            int fi = (int)graph[from].size();",
            "            int ti = (int)graph[to].size();",
            "            if (from == to) ti++;",
            "            graph[from].push_back({to, ti, cap});",
            "            graph[to].push_back({from, fi, 0});",
            "        }",
            "",
            "        bool bfs(int s, int t, vector<int>& level) const {",
            "            fill(level.begin(), level.end(), -1);",
            "            queue<int> que;",
            "            level[s] = 0;",
            "            que.push(s);",
            "            while (!que.empty()) {",
            "                int v = que.front();",
            "                que.pop();",
            "                for (const Edge& e : graph[v]) {",
            "                    if (e.cap == 0 || level[e.to] != -1) continue;",
            "                    level[e.to] = level[v] + 1;",
            "                    que.push(e.to);",
            "                }",
            "            }",
            "            return level[t] != -1;",
            "        }",
            "",
            "        // 再帰せずにレベルグラフ上の増加路を1本見つけて流す",
            "        Wide augment(int s, int t, Wide limit, const vector<int>& level, vector<int>& iter,",
            "                     vector<int>& vertices, vector<int>& edge_indices, vector<Wide>& minimum) {",
            "            vertices.clear();",
            "            edge_indices.clear();",
            "            minimum.clear();",
            "            vertices.push_back(s);",
            "            minimum.push_back(limit);",
            "",
            "            while (!vertices.empty()) {",
            "                int v = vertices.back();",
            "                if (v == t) {",
            "                    Wide pushed = minimum.back();",
            "                    for (int i = 0; i < (int)edge_indices.size(); i++) {",
            "                        Edge& e = graph[vertices[i]][edge_indices[i]];",
            "                        e.cap -= pushed;",
            "                        graph[e.to][e.rev].cap += pushed;",
            "                    }",
            "                    return pushed;",
            "                }",
            "",
            "                int& i = iter[v];",
            "                while (i < (int)graph[v].size()) {",
            "                    const Edge& e = graph[v][i];",
            "                    if (e.cap > 0 && level[e.to] == level[v] + 1) break;",
            "                    i++;",
            "                }",
            "                if (i == (int)graph[v].size()) {",
            "                    vertices.pop_back();",
            "                    minimum.pop_back();",
            "                    if (vertices.empty()) break;",
            "                    edge_indices.pop_back();",
            "                    iter[vertices.back()]++;",
            "                } else {",
            "                    const Edge& e = graph[v][i];",
            "                    edge_indices.push_back(i);",
            "                    vertices.push_back(e.to);",
            "                    minimum.push_back(min(minimum.back(), e.cap));",
            "                }",
            "            }",
            "            return 0;",
            "        }",
            "",
            "        Wide flow(int s, int t, Wide limit) {",
            "            Wide result = 0;",
            "            int n = (int)graph.size();",
            "            vector<int> level(n), iter(n), vertices, edge_indices;",
            "            vector<Wide> minimum;",
            "            vertices.reserve(n);",
            "            edge_indices.reserve(n);",
            "            minimum.reserve(n);",
            "",
            "            while (result < limit && bfs(s, t, level)) {",
            "                fill(iter.begin(), iter.end(), 0);",
            "                while (result < limit) {",
            "                    Wide pushed = augment(s, t, limit - result, level, iter,",
            "                                          vertices, edge_indices, minimum);",
            "                    if (pushed == 0) break;",
            "                    result += pushed;",
            "                }",
            "            }",
            "            return result;",
            "        }",
            "",
            "        vector<bool> min_cut(int s) const {",
            "            vector<bool> visited(graph.size(), false);",
            "            queue<int> que;",
            "            visited[s] = true;",
            "            que.push(s);",
            "            while (!que.empty()) {",
            "                int v = que.front();",
            "                que.pop();",
            "                for (const Edge& e : graph[v]) {",
            "                    if (e.cap == 0 || visited[e.to]) continue;",
            "                    visited[e.to] = true;",
            "                    que.push(e.to);",
            "                }",
            "            }",
            "            return visited;",
            "        }",
            "    };",
            "",
            "    int n;",
            "    int vertex_count;",
            "    Wide base_value = 0;",
            "    Wide finite_sum = 0;",
            "    vector<Request> requests;",
            "",
            "    bool valid(int i) const {",
            "        return 0 <= i && i < n;",
            "    }",
            "",
            "    void add_edge(int from, int to, Wide cap) {",
            "        assert(cap >= 0);",
            "        if (cap == 0) return;",
            "        requests.push_back({from, to, cap, false});",
            "        const Wide wide_max = (Wide)(((__uint128_t)1 << 127) - 1);",
            "        assert(finite_sum <= wide_max - cap - 1);",
            "        finite_sum += cap;",
            "    }",
            "",
            "    void add_hard_edge(int from, int to) {",
            "        requests.push_back({from, to, 0, true});",
            "    }",
            "",
            "    // 頂点が false / true のときの利益を最小カット用に変換する",
            "    void add_unary(int i, Wide v0, Wide v1) {",
            "        base_value += max(v0, v1);",
            "        if (v0 < v1) add_edge(SOURCE, i, v1 - v0);",
            "        if (v0 > v1) add_edge(i, SINK, v0 - v1);",
            "    }",
            "",
            "public:",
            "    // 初期化: ProjectSelection(n) -> n 個の二択変数 (前提: n >= 0)",
            "    ProjectSelection(int variable_count) : n(variable_count), vertex_count(variable_count) {",
            "        assert(variable_count >= 0);",
            "    }",
            "",
            "    // 定数利益: add_value(value) -> 全ての割当てに value を加算",
            "    void add_value(T value) {",
            "        base_value += Wide(value);",
            "    }",
            "",
            "    // 単項利益: add_value(i, v0, v1) -> i=false/true 時の利益 (nullopt はその状態を禁止)",
            "    void add_value(int i, optional<T> v0, optional<T> v1) {",
            "        assert(valid(i));",
            "        add_unary(i, Wide(v0.value_or(0)), Wide(v1.value_or(0)));",
            "        if (!v0) add_hard_edge(SOURCE, i);",
            "        if (!v1) add_hard_edge(i, SINK);",
            "    }",
            "",
            "    // 二項利益: add_pairwise(i, j, v00, v01, v10, v11) -> (i, j) の各状態に対応する利益 (nullopt は禁止状態)",
            "    // 前提: i != j、4状態すべてを許容する場合は v00 + v11 >= v01 + v10",
            "    void add_pairwise(int i, int j, optional<T> v00, optional<T> v01,",
            "                      optional<T> v10, optional<T> v11) {",
            "        assert(valid(i) && valid(j) && i != j);",
            "        bool f00 = !v00, f01 = !v01, f10 = !v10, f11 = !v11;",
            "        // 00 または 11 を禁止する場合は、01 または 10 の少なくとも一方も禁止する",
            "        assert((!f00 || f01 || f10) && (!f11 || f01 || f10));",
            "",
            "        Wide a = Wide(v00.value_or(0));",
            "        Wide b = Wide(v01.value_or(0));",
            "        Wide c = Wide(v10.value_or(0));",
            "        Wide d = Wide(v11.value_or(0));",
            "        Wide delta = a + d - b - c;",
            "        if (delta < 0) {",
            "            // 禁止状態の値は自由に補完できる。利益表が優モジュラになるよう調整する",
            "            assert(f01 || f10);",
            "            if (f01) b += delta;",
            "            else c += delta;",
            "            delta = 0;",
            "        }",
            "",
            "        // a + (d-b)*i + (b-a)*j - delta*i*(1-j)",
            "        base_value += a;",
            "        add_unary(i, 0, d - b);",
            "        add_unary(j, 0, b - a);",
            "        add_edge(i, j, delta);",
            "",
            "        // 禁止状態を、含意または単項の強制条件に分解する",
            "        if (f10) add_hard_edge(i, j);",
            "        if (f01) add_hard_edge(j, i);",
            "        if (f00 && f01) add_hard_edge(SOURCE, i);",
            "        if (f00 && f10) add_hard_edge(SOURCE, j);",
            "        if (f11 && f01) add_hard_edge(j, SINK);",
            "        if (f11 && f10) add_hard_edge(i, SINK);",
            "    }",
            "",
            "    // 全一致ボーナス: add_all(ids, selected, value) -> 全頂点が selected なら value を加算",
            "    // 前提: ids は相異なる有効な頂点番号を1個以上含み、value >= 0",
            "    void add_all(const vector<int>& ids, bool selected, T value) {",
            "        assert(!ids.empty() && value >= T(0));",
            "        for (int i : ids) assert(valid(i));",
            "        vector<int> sorted = ids;",
            "        sort(sorted.begin(), sorted.end());",
            "        assert(adjacent_find(sorted.begin(), sorted.end()) == sorted.end());",
            "        if (value == T(0)) return;",
            "        if (ids.size() == 1) {",
            "            if (selected) add_unary(ids[0], 0, Wide(value));",
            "            else add_unary(ids[0], Wide(value), 0);",
            "            return;",
            "        }",
            "        assert(vertex_count < numeric_limits<int>::max() - 2);",
            "        int aux = vertex_count++;",
            "        if (selected) {",
            "            // 補助変数が true なら、指定された全変数も true",
            "            add_unary(aux, 0, Wide(value));",
            "            for (int i : ids) add_hard_edge(aux, i);",
            "        } else {",
            "            // 補助変数が false なら、指定された全変数も false",
            "            add_unary(aux, Wide(value), 0);",
            "            for (int i : ids) add_hard_edge(i, aux);",
            "        }",
            "    }",
            "",
            "    // 最大利益: solve() -> {最大利益, 各変数の選択状態, 実行可能性}",
            "    // 解なしの場合は {0, {}, false}。何度呼んでも元の条件から再計算し、条件追加後にも使用可能",
            "    Result solve() const {",
            "        int s = vertex_count, t = vertex_count + 1;",
            "        Wide inf = finite_sum + 1;",
            "        Dinic mf(vertex_count + 2);",
            "        for (const Request& e : requests) {",
            "            int from = (e.from == SOURCE ? s : e.from == SINK ? t : e.from);",
            "            int to = (e.to == SOURCE ? s : e.to == SINK ? t : e.to);",
            "            mf.add_edge(from, to, e.hard ? inf : e.cap);",
            "        }",
            "        Wide cost = mf.flow(s, t, inf);",
            "        if (cost == inf) return Result{T(0), {}, false};",
            "",
            "        Wide answer = base_value - cost;",
            "        assert(Wide(numeric_limits<T>::min()) <= answer &&",
            "               answer <= Wide(numeric_limits<T>::max()));",
            "        vector<bool> cut = mf.min_cut(s);",
            "        vector<bool> selected(n);",
            "        for (int i = 0; i < n; i++) selected[i] = cut[i];",
            "        return Result{T(answer), move(selected), true};",
            "    }",
            "};",
            ""
        ]
    },
    "FunctionalGraph": {
        "prefix": "!FunctionalGraph",
        "body": [
            "",
            "struct FunctionalGraph {",
            "private:",
            "    int n;",
            "    vector<int> ids;",
            "    vector<int> positions;",
            "    vector<int> distances;",
            "    vector<int> entries;",
            "    vector<vector<int>> cycles;",
            "    vector<vector<int>> components;",
            "    vector<int> tin;",
            "    vector<int> tout;",
            "",
            "    // 入次数0の頂点を取り除き、残った閉路と流入頂点の情報を構築する",
            "    template<class T>",
            "    void build(const vector<T>& next) {",
            "        static_assert(is_integral_v<T> && is_signed_v<T> && sizeof(T) <= sizeof(long long),",
            "                      \"next must contain signed integers of at most 64 bits\");",
            "        assert(next.size() <= (size_t)INT_MAX);",
            "        n = (int)next.size();",
            "        ids.assign(n, -1);",
            "        positions.assign(n, -1);",
            "        distances.assign(n, 0);",
            "        entries.assign(n, -1);",
            "        cycles.clear();",
            "        components.clear();",
            "",
            "        vector<int> indegree(n, 0);",
            "        for (int v = 0; v < n; v++) {",
            "            assert(0 <= next[v] && next[v] < n);",
            "            indegree[(int)next[v]]++;",
            "        }",
            "",
            "        queue<int> que;",
            "        for (int v = 0; v < n; v++) {",
            "            if (indegree[v] == 0) que.push(v);",
            "        }",
            "        vector<int> order;",
            "        order.reserve(n);",
            "        while (!que.empty()) {",
            "            int v = que.front();",
            "            que.pop();",
            "            order.push_back(v);",
            "            int to = (int)next[v];",
            "            if (--indegree[to] == 0) que.push(to);",
            "        }",
            "",
            "        // 頂点を昇順に調べるため、サイクルIDは最小頂点番号の昇順になる",
            "        for (int v = 0; v < n; v++) {",
            "            if (indegree[v] == 0 || ids[v] != -1) continue;",
            "            int id = (int)cycles.size();",
            "            vector<int> vertices;",
            "            int cur = v;",
            "            do {",
            "                ids[cur] = id;",
            "                positions[cur] = (int)vertices.size();",
            "                entries[cur] = cur;",
            "                vertices.push_back(cur);",
            "                cur = (int)next[cur];",
            "            } while (cur != v);",
            "            cycles.push_back(move(vertices));",
            "        }",
            "",
            "        // 削除順を逆にたどり、到達サイクルと入口と距離を伝播する",
            "        for (int i = (int)order.size() - 1; i >= 0; i--) {",
