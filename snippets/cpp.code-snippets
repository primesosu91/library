            "            int to = (int)next[v];",
            "            ids[v] = ids[to];",
            "            entries[v] = entries[to];",
            "            distances[v] = distances[to] + 1;",
            "        }",
            "",
            "        // 流入木の部分木を連続区間に割り当て、祖先関係を O(1) で判定できるようにする",
