            "    // 素数個数: count(n) -> n 以下の素数の個数 π(n) (前提: 0 <= n <= N)",
            "    int count(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        return (int)(upper_bound(prime_list.begin(), prime_list.end(), n) - prime_list.begin());",
            "    }",
            "",
            "    // 素数総数: count() -> N 以下の素数の総数",
            "    int count() const {",
            "        return (int)prime_list.size();",
            "    }",
            "",
            "    // k 番目の素数: kth_prime(k) -> 0-index の素数 (前提: 0 <= k < count())",
            "    int kth_prime(int k) const {",
            "        assert(0 <= k && k < count());",
            "        return prime_list[k];",
            "    }",
            "",
            "    // 最小素因数: smallest_prime_factor(n) -> n の最小素因数 (前提: 2 <= n <= N)",
            "    int smallest_prime_factor(int n) const {",
            "        assert(2 <= n && n <= limit);",
            "        return spf[n];",
            "    }",
            "",
            "    // 素因数分解: factorize(n) -> {素因数, 指数} を昇順で返す (前提: n >= 1、n=1 では空)",
            "    vector<pair<long long, int>> factorize(long long n) const {",
            "        assert(n >= 1);",
            "        vector<u64> factors;",
            "        factor_rec((u64)n, factors);",
            "        sort(factors.begin(), factors.end());",
            "        vector<pair<long long, int>> result;",
            "        for (u64 p : factors) {",
            "            if (result.empty() || result.back().first != (long long)p) result.emplace_back((long long)p, 1);",
            "            else result.back().second++;",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 約数列挙: divisors(n) -> 正の約数を昇順に返す (前提: n >= 1)",
            "    vector<long long> divisors(long long n) const {",
            "        assert(n >= 1);",
            "        auto factors = factorize(n);",
            "        vector<long long> result = {1};",
            "        for (auto [p, e] : factors) {",
            "            size_t size = result.size();",
            "            long long power = 1;",
            "            for (int i = 0; i < e; i++) {",
            "                power *= p;",
            "                for (size_t j = 0; j < size; j++) result.push_back(result[j] * power);",
            "            }",
            "        }",
            "        sort(result.begin(), result.end());",
            "        return result;",
            "    }",
            "",
            "    // 約数個数: divisor_count(n) -> 正の約数の個数 (前提: n >= 1)",
            "    long long divisor_count(long long n) const {",
            "        assert(n >= 1);",
            "        long long result = 1;",
            "        for (auto [p, e] : factorize(n)) result *= e + 1;",
            "        return result;",
            "    }",
            "",
            "    // 約数総和: divisor_sum(n) -> 正の約数の総和 (前提: n >= 1、総和が long long に収まる)",
            "    long long divisor_sum(long long n) const {",
            "        assert(n >= 1);",
            "        u128 result = 1;",
            "        for (auto [p, e] : factorize(n)) {",
            "            u128 term = 1, power = 1;",
            "            for (int i = 0; i < e; i++) {",
            "                power *= (u64)p;",
            "                term += power;",
            "            }",
            "            result *= term;",
            "        }",
            "        assert(result <= (u128)LLONG_MAX);",
            "        return (long long)result;",
            "    }",
            "",
            "    // Euler の φ 関数: euler_phi(n) -> 1 <= k <= n かつ gcd(k,n)=1 の整数 k の個数 (前提: n >= 1)",
            "    long long euler_phi(long long n) const {",
            "        assert(n >= 1);",
            "        long long result = n;",
            "        for (auto [p, e] : factorize(n)) result = result / p * (p - 1);",
            "        return result;",
            "    }",
            "",
            "    // Möbius 関数: mobius(n) -> μ(n) ∈ {-1,0,1} (前提: n >= 1)",
            "    int mobius(long long n) const {",
            "        assert(n >= 1);",
            "        int result = 1;",
            "        for (auto [p, e] : factorize(n)) {",
            "            if (e >= 2) return 0;",
            "            result = -result;",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // Euler の φ 関数の一括計算: euler_phi_table(n) -> φ(0)..φ(n) (前提: 0 <= n <= N、φ(0) は 0)",
            "    vector<int> euler_phi_table(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        vector<int> result(n + 1, 0);",
            "        if (n >= 1) result[1] = 1;",
            "        for (int i = 2; i <= n; i++) {",
            "            int p = spf[i], m = i / p;",
            "            result[i] = m % p == 0 ? result[m] * p : result[m] * (p - 1);",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // Möbius 関数の一括計算: mobius_table(n) -> μ(0)..μ(n) (前提: 0 <= n <= N、μ(0) は 0)",
            "    vector<int> mobius_table(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        vector<int> result(n + 1, 0);",
            "        if (n >= 1) result[1] = 1;",
            "        for (int i = 2; i <= n; i++) {",
            "            int p = spf[i], m = i / p;",
            "            result[i] = m % p == 0 ? 0 : -result[m];",
            "        }",
            "        return result;",
            "    }",
            "",
            "    // 約数個数の一括計算: divisor_count_table(n) -> d(0)..d(n) (前提: 0 <= n <= N、d(0) は 0)",
            "    vector<int> divisor_count_table(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        vector<int> result(n + 1, 0), exponent(n + 1, 0);",
            "        if (n >= 1) result[1] = 1;",
            "        for (int i = 2; i <= n; i++) {",
            "            int p = spf[i], m = i / p;",
            "            if (m % p == 0) {",
            "                exponent[i] = exponent[m] + 1;",
            "                result[i] = result[m] / (exponent[m] + 1) * (exponent[i] + 1);",
            "            } else {",
            "                exponent[i] = 1;",
            "                result[i] = result[m] * 2;",
            "            }",
            "        }",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "Dijkstra": {
        "prefix": "!Dijkstra",
        "body": [
            "",
            "template<class T = long long>",
            "struct Dijkstra {",
            "    static_assert(is_arithmetic_v<T> && !is_same_v<T, bool>, \"T must be a numeric type\");",
            "",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        T cost;",
            "        int id;",
            "    };",
            "",
            "    static constexpr T inf = numeric_limits<T>::max() / 4;",
            "",
            "private:",
            "    int n;",
            "    int edge_count;",
            "    int source;",
            "    vector<vector<Edge>> graph;",
            "    vector<T> distance;",
            "    vector<Edge> parent_edge;",
            "",
            "    // 指定した辺IDを持つ有向辺を内部に格納",
            "    void add_arc(int from, int to, T cost, int id) {",
            "        graph[from].push_back({from, to, cost, id});",
            "    }",
            "",
            "public:",
            "    // 初期化: Dijkstra(頂点数 n) -> n 頂点の空グラフ (前提: n >= 0)",
            "    Dijkstra(int vertex_count) : n(vertex_count), edge_count(0), source(-1) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to, cost) -> 新しい辺ID (前提: 頂点が有効、0 <= cost < inf)",
            "    int add_edge(int from, int to, T cost) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        assert(T(0) <= cost && cost < inf);",
            "        int id = edge_count++;",
            "        add_arc(from, to, cost, id);",
            "        source = -1;",
            "        return id;",
            "    }",
            "",
            "    // 無向辺追加: add_undirected_edge(u, v, cost) -> 両方向で共通の辺ID (前提: 頂点が有効、0 <= cost < inf)",
            "    int add_undirected_edge(int u, int v, T cost) {",
            "        assert(0 <= u && u < n && 0 <= v && v < n);",
            "        assert(T(0) <= cost && cost < inf);",
            "        int id = edge_count++;",
            "        add_arc(u, v, cost, id);",
            "        add_arc(v, u, cost, id);",
            "        source = -1;",
            "        return id;",
            "    }",
            "",
            "    // 最短路計算: build(s) -> 始点 s から全頂点への最短距離と復元情報を構築",
            "    // 前提: 0 <= s < n、各辺の重みが非負かつ inf 未満、必要な最短距離も inf 未満",
            "    void build(int s) {",
            "        assert(0 <= s && s < n);",
            "        source = s;",
            "        distance.assign(n, inf);",
            "        parent_edge.assign(n, {-1, -1, T(0), -1});",
            "        priority_queue<pair<T, int>, vector<pair<T, int>>, greater<pair<T, int>>> pq;",
            "        distance[s] = T(0);",
            "        pq.push({T(0), s});",
            "",
            "        while (!pq.empty()) {",
            "            auto [d, v] = pq.top();",
            "            pq.pop();",
            "            if (distance[v] != d) continue;",
            "",
            "            for (const Edge& e : graph[v]) {",
            "                // inf 以上の経路は到達不能として扱い、加算のオーバーフローも防ぐ",
            "                if (e.cost >= inf - d) continue;",
            "                T next_dist = d + e.cost;",
            "                if (next_dist >= distance[e.to]) continue;",
            "                distance[e.to] = next_dist;",
            "                parent_edge[e.to] = e;",
            "                pq.push({next_dist, e.to});",
            "            }",
            "        }",
            "    }",
            "",
            "    // 最短距離: dist(v) -> 始点から v への距離 (到達不能または最短距離が inf 以上なら inf、前提: build 済み、0 <= v < n)",
            "    T dist(int v) const {",
            "        assert(source != -1 && 0 <= v && v < n);",
            "        return distance[v];",
            "    }",
            "",
            "    // 全最短距離: distances() -> 頂点順の距離配列への参照 (前提: build 済み、再計算や辺追加後は再取得)",
            "    const vector<T>& distances() const {",
            "        assert(source != -1);",
            "        return distance;",
            "    }",
            "",
            "    // 到達判定: reachable(v) -> 始点から v への最短距離が inf 未満なら true (前提: build 済み、0 <= v < n)",
            "    bool reachable(int v) const {",
            "        assert(source != -1 && 0 <= v && v < n);",
            "        return distance[v] != inf;",
            "    }",
            "",
            "    // 頂点列復元: path(v) -> 始点から v までの頂点列 (最短距離が inf 以上なら空、前提: build 済み、0 <= v < n)",
            "    vector<int> path(int v) const {",
            "        assert(source != -1 && 0 <= v && v < n);",
            "        if (!reachable(v)) return {};",
            "        vector<int> result;",
            "        for (int cur = v; cur != source; cur = parent_edge[cur].from) {",
            "            result.push_back(cur);",
            "        }",
            "        result.push_back(source);",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "",
            "    // 辺列復元: edge_path(v) -> 始点から v までの辺列 (最短距離が inf 以上・始点自身なら空、前提: build 済み、0 <= v < n)",
            "    vector<Edge> edge_path(int v) const {",
            "        assert(source != -1 && 0 <= v && v < n);",
            "        if (!reachable(v)) return {};",
            "        vector<Edge> result;",
            "        for (int cur = v; cur != source; cur = parent_edge[cur].from) {",
            "            result.push_back(parent_edge[cur]);",
            "        }",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "WarshallFloyd": {
        "prefix": "!WarshallFloyd",
        "body": [
            "",
            "template<class T = long long>",
            "struct WarshallFloyd {",
            "    static_assert(is_arithmetic_v<T> && is_signed_v<T>, \"T must be a signed numeric type\");",
            "",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        T cost;",
            "        int id;",
            "    };",
            "",
            "    static constexpr T inf = numeric_limits<T>::max() / 4;",
            "    static constexpr T neg_inf = -inf;",
