    "CoordinateCompression": {
        "prefix": "!CoordinateCompression",
        "body": [
            "",
            "template<class T>",
            "struct CoordinateCompression {",
            "private:",
            "    vector<T> data;",
            "",
            "public:",
            "    // 初期化: CoordinateCompression(初期配列 v) -> 昇順・重複なしの座標表を O(n log n) で構築",
            "    // 前提: T に大小比較・等値比較が定義される",
            "    CoordinateCompression(const vector<T>& v) : data(v) {",
            "        sort(data.begin(), data.end());",
            "        data.erase(unique(data.begin(), data.end()), data.end());",
            "    }",
            "",
            "    // 座標数: size() -> 異なる登録値の個数",
            "    int size() const {",
            "        return (int)data.size();",
            "    }",
            "",
            "    // 圧縮: get(値 x) -> x の圧縮後の座標（前提: x は登録済み）",
            "    int get(const T& x) const {",
            "        int i = lower_bound(x);",
            "        assert(i < size() && data[i] == x);",
            "        return i;",
            "    }",
            "",
            "    // 復元: value(座標 i) -> 対応する元の値（0 <= i < size()）",
            "    const T& value(int i) const {",
            "        assert(0 <= i && i < size());",
            "        return data[i];",
            "    }",
            "",
            "    // 配列圧縮: compress(配列 v) -> 各値の圧縮後の座標（前提: 全要素が登録済み）",
            "    vector<int> compress(const vector<T>& v) const {",
            "        vector<int> result;",
            "        result.reserve(v.size());",
            "        for (const T& x : v) result.push_back(get(x));",
            "        return result;",
            "    }",
            "",
            "    // 下限位置: lower_bound(値 x) -> x 未満の登録値の個数（x は未登録でもよい）",
            "    int lower_bound(const T& x) const {",
            "        return (int)(std::lower_bound(data.begin(), data.end(), x) - data.begin());",
            "    }",
            "",
            "    // 上限位置: upper_bound(値 x) -> x 以下の登録値の個数（x は未登録でもよい）",
            "    int upper_bound(const T& x) const {",
            "        return (int)(std::upper_bound(data.begin(), data.end(), x) - data.begin());",
            "    }",
            "};",
            ""
        ]
    },
    "LIS": {
        "prefix": "!LIS",
        "body": [
            "",
            "template<class T>",
            "struct LIS {",
            "private:",
            "    vector<T> data;",
            "    vector<int> dp;",
            "    vector<int> prev;",
            "    int last;",
            "    int lis_length;",
            "",
            "public:",
            "    // 初期化: LIS(配列 v, 狭義増加 strict = true) -> LIS と復元情報を O(n log n) で構築",
            "    // 前提: T は大小比較・コピーが可能。strict = false なら広義増加を扱う",
            "    LIS(const vector<T>& v, bool strict = true)",
            "        : data(v), dp(v.size()), prev(v.size(), -1), last(-1), lis_length(0) {",
            "        assert(v.size() <= (size_t)INT_MAX);",
            "",
            "        vector<T> tail;",
            "        vector<int> tail_index;",
            "        tail.reserve(v.size());",
            "        tail_index.reserve(v.size());",
            "",
            "        for (int i = 0; i < (int)v.size(); i++) {",
            "            // 長さ pos + 1 の増加部分列を、末尾の値が最小となるよう更新する",
            "            int pos;",
            "            if (strict) {",
            "                pos = (int)(lower_bound(tail.begin(), tail.end(), v[i]) - tail.begin());",
            "            } else {",
            "                pos = (int)(upper_bound(tail.begin(), tail.end(), v[i]) - tail.begin());",
            "            }",
            "",
            "            dp[i] = pos + 1;",
            "            if (pos > 0) prev[i] = tail_index[pos - 1];",
            "            if (pos == (int)tail.size()) {",
            "                tail.push_back(v[i]);",
            "                tail_index.push_back(i);",
            "            } else {",
            "                tail[pos] = v[i];",
            "                tail_index[pos] = i;",
            "            }",
            "        }",
            "",
            "        lis_length = (int)tail.size();",
            "        if (lis_length > 0) last = tail_index.back();",
            "    }",
            "",
            "    // 最大長: length() -> LIS 全体の最大長",
            "    int length() const {",
            "        return lis_length;",
            "    }",
            "",
            "    // 添字列の復元: indices() -> LIS を構成する元配列の 0-index 添字列（最適解のうち1つ）",
            "    vector<int> indices() const {",
            "        vector<int> result;",
            "        for (int i = last; i != -1; i = prev[i]) result.push_back(i);",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "",
            "    // 値列の復元: sequence() -> LIS を構成する値列（最適解のうち1つ）",
            "    vector<T> sequence() const {",
            "        vector<T> result;",
            "        for (int i = last; i != -1; i = prev[i]) result.push_back(data[i]);",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "",
            "    // 各位置の最大長: lengths() -> dp[i] は必ず位置 i で終わる LIS の長さ（参照を返す）",
            "    const vector<int>& lengths() const {",
            "        return dp;",
            "    }",
            "};",
            ""
        ]
    },
    "BFS": {
        "prefix": "!BFS",
        "body": [
            "",
            "struct BFS {",
            "public:",
            "    struct Edge {",
            "        int from;",
            "        int to;",
            "        int id;",
            "    };",
            "",
            "    static constexpr int inf = numeric_limits<int>::max() / 4;",
            "",
            "private:",
            "    int n;",
            "    int edge_count;",
            "    bool built;",
            "    vector<vector<Edge>> graph;",
            "    vector<int> distance;",
            "    vector<Edge> parent_edge;",
            "",
            "    // 指定した辺IDを持つ有向辺を内部に格納",
            "    void add_arc(int from, int to, int id) {",
            "        graph[from].push_back({from, to, id});",
            "    }",
            "",
            "public:",
            "    // 初期化: BFS(n) -> n 頂点の空グラフ (前提: n >= 0)",
            "    BFS(int vertex_count) : n(vertex_count), edge_count(0), built(false) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to) -> 新しい辺ID (前提: 頂点が有効)",
            "    int add_edge(int from, int to) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        int id = edge_count++;",
            "        add_arc(from, to, id);",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // 無向辺追加: add_undirected_edge(u, v) -> 両方向で共通の辺ID (前提: 頂点が有効)",
            "    int add_undirected_edge(int u, int v) {",
            "        assert(0 <= u && u < n && 0 <= v && v < n);",
            "        int id = edge_count++;",
            "        add_arc(u, v, id);",
            "        add_arc(v, u, id);",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // 単一始点最短路: build(s) -> 始点 s から全頂点への最短距離と復元情報を構築 (前提: 0 <= s < n)",
            "    void build(int s) {",
            "        assert(0 <= s && s < n);",
            "        build(vector<int>{s});",
            "    }",
            "",
            "    // 多点始点最短路: build(sources) -> 始点集合からの最短距離と復元情報を構築 (前提: 全始点が有効、空集合も可)",
            "    void build(const vector<int>& sources) {",
            "        built = false;",
            "        distance.assign(n, inf);",
            "        parent_edge.assign(n, {-1, -1, -1});",
            "        queue<int> que;",
            "",
            "        // 重複する始点は一度だけ登録する",
            "        for (int s : sources) {",
            "            assert(0 <= s && s < n);",
            "            if (distance[s] == 0) continue;",
            "            distance[s] = 0;",
            "            que.push(s);",
            "        }",
            "",
            "        // 初めて訪問したときの辺を記録し、最短路を確定する",
            "        while (!que.empty()) {",
            "            int v = que.front();",
            "            que.pop();",
            "            for (const Edge& e : graph[v]) {",
            "                if (distance[e.to] != inf) continue;",
            "                distance[e.to] = distance[v] + 1;",
            "                parent_edge[e.to] = e;",
            "                que.push(e.to);",
            "            }",
            "        }",
            "        built = true;",
            "    }",
            "",
            "    // 最短距離: dist(v) -> 始点集合から v への距離 (到達不能なら inf、前提: build 済み、0 <= v < n)",
            "    int dist(int v) const {",
            "        assert(built && 0 <= v && v < n);",
            "        return distance[v];",
            "    }",
            "",
            "    // 全最短距離: distances() -> 頂点順の距離配列への参照 (前提: build 済み、再計算や辺追加後は再取得)",
            "    const vector<int>& distances() const {",
            "        assert(built);",
            "        return distance;",
            "    }",
            "",
            "    // 到達判定: reachable(v) -> 始点集合から v に到達できれば true (前提: build 済み、0 <= v < n)",
            "    bool reachable(int v) const {",
            "        assert(built && 0 <= v && v < n);",
            "        return distance[v] != inf;",
            "    }",
            "",
            "    // 頂点列復元: path(v) -> いずれかの始点から v までの頂点列 (到達不能なら空、前提: build 済み、0 <= v < n)",
            "    vector<int> path(int v) const {",
            "        assert(built && 0 <= v && v < n);",
            "        if (!reachable(v)) return {};",
            "        vector<int> result;",
            "        for (int cur = v; cur != -1; cur = parent_edge[cur].from) {",
            "            result.push_back(cur);",
            "        }",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "",
            "    // 辺列復元: edge_path(v) -> 最短経路の辺列 (到達不能・始点自身なら空、前提: build 済み、0 <= v < n)",
            "    vector<Edge> edge_path(int v) const {",
            "        assert(built && 0 <= v && v < n);",
            "        if (!reachable(v)) return {};",
            "        vector<Edge> result;",
            "        for (int cur = v; parent_edge[cur].from != -1; cur = parent_edge[cur].from) {",
            "            result.push_back(parent_edge[cur]);",
            "        }",
            "        reverse(result.begin(), result.end());",
            "        return result;",
            "    }",
            "};",
            ""
        ]
    },
    "SCC": {
        "prefix": "!SCC",
        "body": [
            "",
            "struct SCC {",
            "private:",
            "    int n;",
            "    int edge_count;",
            "    bool built;",
            "    vector<vector<int>> graph;",
            "    vector<vector<int>> reverse_graph;",
            "    vector<int> ids;",
            "    vector<vector<int>> components;",
            "    vector<vector<int>> condensed_graph;",
            "",
            "public:",
            "    // 初期化: SCC(n) -> n 頂点の空の有向グラフ (前提: n >= 0)",
            "    SCC(int vertex_count) : n(vertex_count), edge_count(0), built(false) {",
            "        assert(vertex_count >= 0);",
            "        graph.resize(n);",
            "        reverse_graph.resize(n);",
            "    }",
            "",
            "    // 有向辺追加: add_edge(from, to) -> 新しい辺ID (前提: 頂点が有効)",
            "    int add_edge(int from, int to) {",
            "        assert(0 <= from && from < n && 0 <= to && to < n);",
            "        int id = edge_count++;",
            "        graph[from].push_back(to);",
            "        reverse_graph[to].push_back(from);",
            "        built = false;",
            "        return id;",
            "    }",
            "",
            "    // 強連結成分分解: build() -> 成分IDと縮約DAGを構築 (成分IDはトポロジカル順)",
            "    void build() {",
            "        built = false;",
            "        vector<char> visited(n, false);",
            "        vector<int> next_index(n, 0), order, stack;",
            "        order.reserve(n);",
            "        stack.reserve(n);",
            "",
            "        // 元のグラフで終了順を求める（非再帰DFS）",
            "        for (int root = 0; root < n; root++) {",
            "            if (visited[root]) continue;",
            "            visited[root] = true;",
            "            stack.push_back(root);",
            "            while (!stack.empty()) {",
            "                int v = stack.back();",
            "                if (next_index[v] == (int)graph[v].size()) {",
            "                    order.push_back(v);",
            "                    stack.pop_back();",
            "                    continue;",
            "                }",
            "                int to = graph[v][next_index[v]++];",
            "                if (visited[to]) continue;",
            "                visited[to] = true;",
            "                stack.push_back(to);",
            "            }",
            "        }",
            "",
            "        // 逆向きグラフを終了順の逆順に探索し、成分IDを割り当てる",
            "        ids.assign(n, -1);",
            "        int count = 0;",
            "        for (int i = n - 1; i >= 0; i--) {",
            "            int root = order[i];",
            "            if (ids[root] != -1) continue;",
            "            ids[root] = count;",
            "            stack.push_back(root);",
            "            while (!stack.empty()) {",
            "                int v = stack.back();",
            "                stack.pop_back();",
            "                for (int to : reverse_graph[v]) {",
            "                    if (ids[to] != -1) continue;",
            "                    ids[to] = count;",
            "                    stack.push_back(to);",
            "                }",
            "            }",
            "            count++;",
            "        }",
            "",
            "        // 各成分の頂点を昇順で格納する",
            "        components.assign(count, {});",
            "        for (int v = 0; v < n; v++) components[ids[v]].push_back(v);",
            "",
            "        // 成分間の辺を重複なく格納する（成分ごとに訪問先を記録）",
            "        condensed_graph.assign(count, {});",
            "        vector<int> last_seen(count, -1);",
            "        for (int id = 0; id < count; id++) {",
            "            for (int v : components[id]) {",
            "                for (int to : graph[v]) {",
            "                    int next_id = ids[to];",
            "                    if (next_id == id || last_seen[next_id] == id) continue;",
            "                    last_seen[next_id] = id;",
            "                    condensed_graph[id].push_back(next_id);",
            "                }",
            "            }",
            "        }",
            "        built = true;",
            "    }",
            "",
            "    // 成分数: component_count() -> 強連結成分の個数 (前提: build 済み)",
            "    int component_count() const {",
            "        assert(built);",
            "        return (int)components.size();",
            "    }",
            "",
            "    // 所属成分: component_id(v) -> 頂点vの成分ID (前提: build 済み、0 <= v < n)",
            "    int component_id(int v) const {",
            "        assert(built && 0 <= v && v < n);",
            "        return ids[v];",
            "    }",
            "",
            "    // 同一成分判定: same(u, v) -> 互いに到達可能ならtrue (前提: build 済み、頂点が有効)",
            "    bool same(int u, int v) const {",
            "        assert(built && 0 <= u && u < n && 0 <= v && v < n);",
            "        return ids[u] == ids[v];",
            "    }",
            "",
            "    // 成分一覧: groups() -> 成分ID順の頂点列への参照（各成分内は頂点昇順、前提: build 済み）",
            "    const vector<vector<int>>& groups() const {",
            "        assert(built);",
            "        return components;",
            "    }",
            "",
            "    // 縮約DAG: dag() -> 成分間の重複のない有向辺の隣接リストへの参照（前提: build 済み）",
            "    const vector<vector<int>>& dag() const {",
            "        assert(built);",
            "        return condensed_graph;",
            "    }",
            "};",
            ""
        ]
    }
