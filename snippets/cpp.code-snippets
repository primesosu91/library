            "public:",
            "    // 初期化: WarshallFloyd(n) -> n 頂点の空グラフ (前提: n >= 0)",
            "    WarshallFloyd(int vertex_count) : n(vertex_count), edge_count(0), built(false), negative_cycle(false) {",
