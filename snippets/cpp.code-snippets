            "        return ids[v];",
            "    }",
            "",
            "    // 到達サイクル長: cycle_length(v) -> 頂点vから到達するサイクルの長さ",
            "    int cycle_length(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return (int)cycles[ids[v]].size();",
            "    }",
            "",
            "    // サイクル長: cycle_size(id) -> サイクルidの長さ",
            "    int cycle_size(int id) const {",
            "        assert(0 <= id && id < cycle_count());",
            "        return (int)cycles[id].size();",
            "    }",
            "",
            "    // サイクル頂点列: cycle_vertices(id) -> 最小頂点から辺の向きに沿った頂点列への参照",
            "    const vector<int>& cycle_vertices(int id) const {",
            "        assert(0 <= id && id < cycle_count());",
            "        return cycles[id];",
            "    }",
            "",
            "    // サイクル内の位置: cycle_pos(v) -> サイクル外では -1",
            "    int cycle_pos(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return positions[v];",
            "    }",
            "",
            "    // サイクル上か: in_cycle(v) -> サイクルに属する場合true",
            "    bool in_cycle(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return distances[v] == 0;",
            "    }",
            "",
            "    // サイクルまでの距離: dist_to_cycle(v) -> 到達までの遷移回数",
            "    int dist_to_cycle(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return distances[v];",
            "    }",
            "",
            "    // 最初に到達するサイクル頂点: cycle_entry(v) -> 頂点番号",
            "    int cycle_entry(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return entries[v];",
            "    }",
            "",
            "    // 成分の大きさ: component_size(id) -> サイクルidに流入する頂点を含む個数",
            "    int component_size(int id) const {",
            "        assert(0 <= id && id < cycle_count());",
            "        return (int)components[id].size();",
            "    }",
            "",
            "    // 成分の頂点列: component_vertices(id) -> 頂点番号昇順の頂点列への参照",
            "    const vector<int>& component_vertices(int id) const {",
            "        assert(0 <= id && id < cycle_count());",
            "        return components[id];",
            "    }",
            "",
            "    // 到達判定: reachable(from, to) -> from から to に到達できるか",
            "    bool reachable(int from, int to) const {",
            "        return dist(from, to) != -1;",
            "    }",
            "",
            "    // 頂点間距離: dist(from, to) -> 最小遷移回数、到達不能なら -1",
            "    int dist(int from, int to) const {",
            "        assert(0 <= from && from < n);",
            "        assert(0 <= to && to < n);",
            "        if (ids[from] != ids[to]) return -1;",
            "",
            "        // to が流入木にある場合、to は from の祖先でなければならない",
            "        if (distances[to] > 0) {",
            "            if (tin[to] <= tin[from] && tin[from] < tout[to]) {",
            "                return distances[from] - distances[to];",
            "            }",
            "            return -1;",
            "        }",
            "",
            "        // to がサイクル上なら、入口までの距離とサイクル上の距離を足す",
            "        int length = (int)cycles[ids[from]].size();",
            "        int from_pos = positions[entries[from]];",
            "        int to_pos = positions[to];",
            "        int cycle_dist = to_pos >= from_pos ? to_pos - from_pos",
            "                                           : length - from_pos + to_pos;",
            "        return distances[from] + cycle_dist;",
            "    }",
            "",
            "    // 到達可能頂点数: reachable_count(v) -> v から到達する異なる頂点の個数（v 自身を含む）",
            "    int reachable_count(int v) const {",
            "        assert(0 <= v && v < n);",
            "        return distances[v] + (int)cycles[ids[v]].size();",
            "    }",
            "};",
            ""
        ]
    },
    "ArgumentSort": {
        "prefix": "!ArgumentSort",
        "body": [
            "",
            "// 外積の符号: cross_sign(a, b) -> a x b の符号 (-1, 0, 1)",
            "// 前提: T は 64-bit 以下の符号付き整数型",
            "// 正なら a から b は反時計回り、負なら時計回り、0 なら平行",
            "// ゼロベクトルを含む場合も 0 を返す",
            "// (座標値は __int128 で演算できる範囲とする)",
            "template<class T>",
            "int cross_sign(const pair<T, T>& a, const pair<T, T>& b) {",
            "    static_assert(is_integral_v<T> && is_signed_v<T> && sizeof(T) <= 8,",
            "                  \"T must be a signed integer type of at most 64 bits\");",
            "    __int128_t cross = (__int128_t)a.first * b.second - (__int128_t)a.second * b.first;",
            "    return (cross > 0) - (cross < 0);",
            "}",
            "",
            "template<class T = long long>",
            "struct ArgumentLess {",
            "    static_assert(is_integral_v<T> && is_signed_v<T> && sizeof(T) <= 8,",
            "                  \"T must be a signed integer type of at most 64 bits\");",
            "",
            "    pair<T, T> origin;",
            "",
            "    // 基準点の設定: ArgumentLess(origin) -> 原点を省略すると (0, 0)",
            "    // 前提: 各点と基準点の座標差の絶対値は 10^18 以下",
            "    ArgumentLess(pair<T, T> origin = {0, 0}) : origin(origin) {}",
            "",
            "    // 偏角順比較: operator()(a, b) -> a が b より先なら true",
            "    // (0, 0) 方向のゼロベクトルは先頭、角度は正の x 軸から反時計回り",
            "    // 同方向は基準点からの距離が小さい順、同一点は同値",
            "    // 前提: 各点と基準点の座標差の絶対値は 10^18 以下",
            "    bool operator()(const pair<T, T>& a, const pair<T, T>& b) const {",
            "        using i128 = __int128_t;",
            "        i128 ax = (i128)a.first - origin.first;",
            "        i128 ay = (i128)a.second - origin.second;",
            "        i128 bx = (i128)b.first - origin.first;",
            "        i128 by = (i128)b.second - origin.second;",
            "",
            "        // 基準点と一致する点は、他のどの点よりも先に置く",
            "        bool az = (ax == 0 && ay == 0);",
            "        bool bz = (bx == 0 && by == 0);",
            "        if (az != bz) return az;",
            "        if (az) return false;",
            "",
            "        // 正の x 軸から上半平面を先にし、負の x 軸から下半平面を後にする",
            "        auto half = [](i128 x, i128 y) {",
            "            return (y > 0 || (y == 0 && x > 0)) ? 0 : 1;",
            "        };",
            "        int ha = half(ax, ay), hb = half(bx, by);",
            "        if (ha != hb) return ha < hb;",
            "",
            "        i128 cross = ax * by - ay * bx;",
            "        if (cross != 0) return cross > 0;",
            "",
            "        // 同方向のベクトルは距離の二乗で比較",
            "        i128 da = ax * ax + ay * ay;",
            "        i128 db = bx * bx + by * by;",
            "        return da < db;",
            "    }",
            "};",
            "",
            "// 偏角ソート: argument_sort(points, origin) -> 点列をその場で昇順ソート",
            "// 前提: 各点と基準点の座標差の絶対値は 10^18 以下",
            "// 基準点 origin を省略すると (0, 0)、ゼロベクトルは先頭",
            "template<class T>",
            "void argument_sort(vector<pair<T, T>>& points, pair<T, T> origin = {0, 0}) {",
            "    sort(points.begin(), points.end(), ArgumentLess<T>(origin));",
            "}",
            ""
        ]
    },
    "Combination": {
        "prefix": "!Combination",
        "body": [
            "",
            "template<class Mint>",
            "struct Combination {",
            "private:",
            "    int limit;",
            "    vector<Mint> factorial, inverse_factorial;",
            "",
            "    // 素数MODであることを初期化時に一度だけ確認する",
            "    static bool is_prime_mod() {",
            "        int p = Mint::mod();",
            "        if (p < 2) return false;",
            "        for (int d = 2; (long long)d * d <= p; d++) {",
            "            if (p % d == 0) return false;",
            "        }",
            "        return true;",
            "    }",
            "",
            "    // 前計算範囲外も積で求める階乗 (前提: 0 <= n < MOD)",
            "    Mint factorial_value(long long n) const {",
            "        if (n <= limit) return factorial[(int)n];",
            "        Mint result = factorial[limit];",
            "        for (long long i = (long long)limit + 1; i <= n; i++) result *= Mint(i);",
            "        return result;",
            "    }",
            "",
            "    // 1桁の組合せ数。前計算・乗算・MOD直前の恒等式を使い分ける",
            "    Mint comb_digit(long long n, long long r) const {",
            "        if (r > n) return Mint(0);",
            "        if (n <= limit) {",
            "            return factorial[(int)n] * inverse_factorial[(int)r]",
            "                   * inverse_factorial[(int)(n - r)];",
            "        }",
            "        long long k = min(r, n - r);",
            "        long long a = (long long)Mint::mod() - 1 - n;",
            "        if (a < k) {",
            "            // C(p-1-a,k) = (-1)^k C(k+a,a) (mod p)",
            "            Mint result = 1;",
            "            for (long long i = 1; i <= a; i++) result *= Mint(k + i);",
            "            if (a <= limit) result *= inverse_factorial[(int)a];",
            "            else result /= factorial_value(a);",
            "            if (k & 1) result = -result;",
            "            return result;",
            "        }",
            "        Mint result = 1;",
            "        for (long long i = 1; i <= k; i++) result *= Mint(n - k + i);",
            "        if (k <= limit) result *= inverse_factorial[(int)k];",
            "        else result /= factorial_value(k);",
            "        return result;",
            "    }",
            "",
            "    // Lucasの定理。重複組合せの中間値がlong longを超える場合にも対応",
            "    Mint comb_large(unsigned __int128 n, unsigned __int128 r) const {",
            "        const unsigned __int128 p = (unsigned int)Mint::mod();",
            "        Mint result = 1;",
            "        while (n > 0 || r > 0) {",
            "            long long ni = (long long)(n % p);",
            "            long long ri = (long long)(r % p);",
            "            if (ri > ni) return Mint(0);",
            "            result *= comb_digit(ni, ri);",
            "            n /= p;",
            "            r /= p;",
            "        }",
            "        return result;",
            "    }",
            "",
            "public:",
            "    // 初期化: Combination(n) -> 0..n の階乗・逆階乗を前計算 (前提: MODは素数、0 <= n < MOD)",
            "    Combination(int n = 0) {",
            "        static const bool prime = is_prime_mod();",
            "        assert(prime);",
            "        build(n);",
            "    }",
            "",
            "    // 再構築: build(n) -> 前計算範囲を0..nに変更 (前提: 0 <= n < MOD)",
            "    void build(int n) {",
            "        assert(0 <= n && n < Mint::mod());",
            "        limit = n;",
            "        factorial.assign(n + 1, Mint(1));",
            "        inverse_factorial.assign(n + 1, Mint(1));",
            "        for (int i = 1; i <= n; i++) factorial[i] = factorial[i - 1] * Mint(i);",
            "        inverse_factorial[n] = factorial[n].inv();",
            "        for (int i = n; i >= 1; i--) inverse_factorial[i - 1] = inverse_factorial[i] * Mint(i);",
            "    }",
            "",
            "    // 組合せ数: comb(n,r) -> C(n,r) mod MOD (前提: n >= 0、MODは素数; r<0 または r>n は0)",
            "    Mint comb(long long n, long long r) const {",
            "        assert(n >= 0);",
            "        if (r < 0 || r > n) return Mint(0);",
            "        return comb_large((unsigned long long)n, (unsigned long long)r);",
            "    }",
            "",
            "    // 順列数: perm(n,r) -> nPr mod MOD (前提: n >= 0、MODは素数; r<0 または r>n は0)",
            "    Mint perm(long long n, long long r) const {",
            "        assert(n >= 0);",
            "        if (r < 0 || r > n) return Mint(0);",
            "        if (r == 0) return Mint(1);",
            "        long long x = n % Mint::mod();",
            "        if (r > x) return Mint(0); // 連続するr項の中にMODの倍数がある",
            "        if (x <= limit) return factorial[(int)x] * inverse_factorial[(int)(x - r)];",
            "        long long a = (long long)Mint::mod() - 1 - x;",
            "        long long b = x - r;",
            "        if (r <= a + b) {",
            "            Mint result = 1;",
            "            for (long long i = 0; i < r; i++) result *= Mint(x - i);",
            "            return result;",
            "        }",
            "        // Wilsonの定理: x!/(x-r)! = (-1)^(a+1)/(a! b!) (mod p)",
            "        Mint result = (factorial_value(a) * factorial_value(b)).inv();",
            "        if ((a + 1) & 1) result = -result;",
            "        return result;",
            "    }",
            "",
            "    // 重複組合せ数: hcomb(n,r) -> H(n,r) mod MOD (前提: n >= 0; r<0 は0、H(0,0)=1)",
            "    Mint hcomb(long long n, long long r) const {",
            "        assert(n >= 0);",
            "        if (r < 0) return Mint(0);",
            "        if (n == 0) return Mint(r == 0 ? 1 : 0);",
            "        return comb_large((unsigned __int128)(unsigned long long)n",
            "                          + (unsigned long long)r - 1, (unsigned long long)r);",
            "    }",
            "",
            "    // 階乗: fact(n) -> n! mod MOD (前提: 0 <= n <= 前計算上限)",
            "    Mint fact(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        return factorial[n];",
            "    }",
            "",
            "    // 逆階乗: inv_fact(n) -> (n!)^(-1) mod MOD (前提: 0 <= n <= 前計算上限)",
            "    Mint inv_fact(int n) const {",
            "        assert(0 <= n && n <= limit);",
            "        return inverse_factorial[n];",
            "    }",
            "",
            "    // 逆元: inv(n) -> n^(-1) mod MOD (前提: n >= 1、n % MOD != 0)",
            "    Mint inv(long long n) const {",
            "        assert(n >= 1 && n % Mint::mod() != 0);",
            "        int x = (int)(n % Mint::mod());",
            "        if (x <= limit) return factorial[x - 1] * inverse_factorial[x];",
            "        return Mint(x).inv();",
            "    }",
            "};",
            ""
        ]
    }
